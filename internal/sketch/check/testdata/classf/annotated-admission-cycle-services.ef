package p
type Cap interface{ M() }
type Box[T any] interface{ M(T) }
func BoxOf[T any](x T) Box[T]
func Choose[T any](x T,y T) needs Cap
func a() needs Cap {_ = b;Choose(BoxOf(a),BoxOf(d))}
func b() needs Cap {Choose(BoxOf(c),BoxOf(a))}
func c() needs Cap {Choose(BoxOf(a),BoxOf(d))}
func d() needs Cap {Choose(BoxOf(c),BoxOf(a))}

