type Cap {M()}
type Box[T] {M(T)}
extern go fixture.BoxOf func BoxOf[T](x T) Box[T]
extern go fixture.Choose func Choose[T](x T,y T) needs Cap
func a(){_ = func() needs Cap{b()};Choose(BoxOf(func() needs Cap{a()}),BoxOf(func() needs Cap{d()}))}
func b(){Choose(BoxOf(func() needs Cap{c()}),BoxOf(func() needs Cap{a()}))}
func c(){Choose(BoxOf(func() needs Cap{a()}),BoxOf(func() needs Cap{d()}))}
func d(){Choose(BoxOf(func() needs Cap{c()}),BoxOf(func() needs Cap{a()}))}


