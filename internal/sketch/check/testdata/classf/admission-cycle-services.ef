package p
type Cap interface{ M() }
type Box[T any] interface{ M(T) }
func BoxOf[T any](x T) Box[T]
func Choose[T any](x T,y T) needs Cap
func a() {_ = b;Choose(BoxOf(a),BoxOf(d))} // want S108 S108 S108
func b() {Choose(BoxOf(c),BoxOf(a))} // want S108
func c() {Choose(BoxOf(a),BoxOf(d))}
func d() {Choose(BoxOf(c),BoxOf(a))}

