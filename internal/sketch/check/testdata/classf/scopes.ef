package p
type Cap interface{ M() }
type Bang struct{}
type Other struct{}
type Shape interface{ Bang | Other }
func mark() error[Bang]
func h() { Cap.M() }
func k() { Cap.M() }
func r() { Cap.M() }
func s() { Cap.M() }
func x() { Cap.M() }
func y() { Cap.M() }
func e() { Cap.M() }
func g(h int) int { return h }
func ranges(xs []int) int {
	n := 0
	for k, r := range xs {
		n = n + k + r
	}
	return n
}
func switches(v Shape) int {
	switch s := v.(type) {
	case Bang:
		_ = s
		return 1
	case Other:
		_ = s
		return 2
	}
}
func catches() {
	mark() catch e {
		case Bang: _ = e
	}
}
func blocks() int {
	x := 1
	if y := x; y > 0 {
		return y
	}
	for x := 0; x < 2; x = x + 1 {
		_ = x
	}
	return x
}
func literals() int {
	f := func(k int) int { return k }
	return f(1)
}
func F() needs Cap { h(); k(); r(); s(); x(); y(); e() }
func G() int { return g(1) + ranges([]int{1}) + switches(Bang{}) + blocks() + literals() }
func C() { catches() }
