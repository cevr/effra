type Bang {}
type Node { kids []Node }
extern go fixture.each func each(xs []Node, f func(Node) fails Bang) fails Bang
extern go fixture.mark func mark() fails Bang
func visit(k Node) { try mark() }
func walk(n Node) { try mark(); try each(n.kids, func(k Node) { try visit(k) }) }
func F(n Node) fails Bang { try walk(n) }
