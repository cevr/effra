package p
type Cap interface{M()}
type Box[T any] interface{M(T)}
func BoxOf[T any](x T) Box[T]
func Choose[T any](x T,y T) needs Cap
func a() needs Cap{_ = func(){b()};Choose(BoxOf(func(){a()}),BoxOf(func(){d()}))}
func b() needs Cap{Choose(BoxOf(func(){c()}),BoxOf(func(){a()}))}
func c() needs Cap{Choose(BoxOf(func(){a()}),BoxOf(func(){d()}))}
func d() needs Cap{Choose(BoxOf(func(){c()}),BoxOf(func(){a()}))}

