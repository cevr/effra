package p
type Cap interface{M()}
type Box[T any] interface{M(T)}
func BoxOf[T any](x T) Box[T]
func Choose[T any](x T,y T) needs Cap
func a(){_ = func(){b()};Choose(BoxOf(func(){a()}),BoxOf(func(){d()}))} // want S108
func b(){Choose(BoxOf(func(){c()}),BoxOf(func(){a()}))} // want S108
func c(){Choose(BoxOf(func(){a()}),BoxOf(func(){d()}))} // want S108
func d(){Choose(BoxOf(func(){c()}),BoxOf(func(){a()}))} // want S108

