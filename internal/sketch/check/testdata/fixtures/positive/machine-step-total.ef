package demo

type ProbeDown struct{}
type Probe interface{ Healthy() (bool, error[ProbeDown]) }
type Closed struct{ Failures int64 }
type Open struct{ Endpoint string }
type State interface{ Closed | Open }
type Failure struct{ Endpoint string }
type Retry struct{}
type Signal interface{ Failure | Retry }

func step(s State, sig Signal) (Decision[State, string], error[ProbeDown]) uses Probe {
	switch st, e := s.(type), sig.(type) {
	case (Closed, Failure):
		if st.Failures >= 2 {
			return Enter{Open{e.Endpoint}}
		}
		return Stay{Closed{st.Failures + 1}}
	case (Open, Retry):
		if try Probe.Healthy() {
			return Enter{Closed{0}}
		}
		return Stay{st}
	case (Closed, Retry):
		return Ignore{}
	case (Open, Failure):
		return Done{"open"}
	}
}

type Breaker machine[State, Signal] {
	initial Closed{0}
	step    step
}

func main() {}
