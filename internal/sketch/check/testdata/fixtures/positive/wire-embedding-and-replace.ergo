type Store { Label() string }
type Account { Label() string }
type Memory { Text string }

func Label(m Memory) string { return m.Text }

let Shared = wire {
	Store: Memory{Text: "live"},
}

let Accounts = wire {
	Account: Memory{Text: "account"},
	Shared,
}

let Fixture = wire {
	replace Store: Memory{Text: "fixture"},
	Accounts,
}

func labels() string needs Store, Account { return Store.Label() + Account.Label() }

func main() needs Console {
	let line = with Fixture { labels() }
	Console.Println("\(line)")
}
