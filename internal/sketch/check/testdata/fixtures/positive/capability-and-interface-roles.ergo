type Store { Get() string }
type Mem {}

func Get(_ Mem) string { return "m" }

func viaValue(s Store) string    { return s.Get() }
func Exported(s Store) string    { return s.Get() }
func viaCap() string needs Store { return Store.Get() }

func main() needs Console {
	let line = Exported(Mem{})
	let line2 = viaValue(Mem{})
	let line3 = with wire { Store: Mem{} } { viaCap() }
	Console.Println("\(line) \(line2) \(line3)")
}
