package demo

type Clocky interface{ Now() int64 }
type Sleepy interface{ Nap(d duration) }
type Virtual struct{}

func (Virtual) Now() int64      { return 0 }
func (Virtual) Nap(d duration) {}

func tick() int64 uses Clocky, Sleepy {
	Sleepy.Nap(1s)
	return Clocky.Now()
}

func main() uses Console {
	Console.Println(with(wire{ Clocky, Sleepy = Virtual{} }) { tick() })
}
