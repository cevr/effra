type Fault {}
type Store { Get() string }
type Mem {}

func Get(_ Mem) string { return "m" }

func fail() fails Fault { return Fault{} }

func even(n int64) string {
	if n == 0 {
		try fail()
		return Store.Get()
	}
	return odd(n - 1)
}

func odd(n int64) string {
	if n == 0 {
		return "odd"
	}
	return even(n - 1)
}

func Run(n int64) string fails Fault needs Store {
	let f = func() string { return even(n) }
	return f()
}

func main() needs Console {
	let v = with wire { Store: Mem{} } { Run(3) } catch {
	case Fault:
		"fault"
	}
	Console.Println("\(v)")
}
