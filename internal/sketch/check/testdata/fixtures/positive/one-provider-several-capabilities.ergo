type Clocky { Now() int64 }
type Sleepy { Nap(d duration) }
type Virtual {}

func Now(_ Virtual) int64       { return 0 }
func Nap(_ Virtual, d duration) {}

func tick() int64 needs Clocky, Sleepy {
	Sleepy.Nap(1s)
	return Clocky.Now()
}

func main() needs Console {
	let line = with wire { Clocky, Sleepy: Virtual{} } { tick() }
	Console.Println("\(line)")
}
