package demo

type Store interface{ Label() string }
type Account interface{ Label() string }
type Memory struct{ Text string }

func (m Memory) Label() string { return m.Text }

wire Shared {
	Store = Memory{Text: "live"}
}

wire Accounts {
	Shared
	Account = Memory{Text: "account"}
}

wire Fixture {
	Accounts
	replace Store = Memory{Text: "fixture"}
}

func labels() string uses Store, Account { return Store.Label() + Account.Label() }

func main() uses Console {
	Console.Println(with(Fixture) { labels() })
}
