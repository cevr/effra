
type Fault {}

type Pair[K comparable, V] {
	Key   K,
	Value V,
}

type Just[T] { Value T }
type Nothing {}
type Maybe[T] = Just[T] | Nothing

func Transform[A, B, E, R](xs []A, f func(A) B fails E needs R) []B fails E needs R {
	let mut out = []B{}
	for x in xs {
		out = out.Append(try f(x))
	}
	return out
}

extern go fixture.On func On[F error, A, E, R](f func() A fails E needs R) A fails E needs R

func same[T comparable](a, b T) bool { return a == b }

func orElse(m Maybe[int64], d int64) int64 {
	match m {
	case Just as v:
		return v.Value
	case Nothing:
		return d
	}
}

func wrap(n int64) Maybe[int64] {
	if n < 0 {
		return Nothing
	}
	return Just{n}
}

func double(n int64) int64 { return n * 2 }

func both(f func() int64 needs (Clocky, Sleepy)) int64 needs Clocky, Sleepy { return f() }

type Clocky { Now() int64 }
type Sleepy { Nap(d duration) }

func main() needs Console {
	let p = Pair[string, int64]{Key: "a", Value: 1}
	let ys = Transform([]int64{1, 2}, double)
	let n = On[Fault](func() int64 fails Fault { return Fault }) catch {
	case Fault:
		0
	}
	Console.Println("\(p.Key) \(len(ys)) \(n) \(same("a", "b")) \(same(int64(1), 2)) \(orElse(wrap(3), 0))")
}
