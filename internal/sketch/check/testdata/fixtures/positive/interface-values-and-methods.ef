package demo

type Store interface{ Get() string }
type Mem struct{ V string }

func (m Mem) Get() string { return m.V }

func NewStore(v string) Store { return Mem{V: v} }
func read(s Store) string     { return s.Get() }

func main() needs Console {
	s := NewStore("x")
	Console.Println(read(s), Mem{V: "y"}.Get(), s.Get())
}
