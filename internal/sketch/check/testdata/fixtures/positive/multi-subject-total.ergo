type A {}
type B {}
type X {}
type Y {}
type AB = A | B
type XY = X | Y

func label(a A, b X) string { return "ax" }

func pair(p AB, q XY) string {
	match (p, q) {
	case (A as a, X as b):
		return label(a, b)
	case (A, Y):
		return "ay"
	case (B, _):
		return "b"
	}
}

func main() needs Console {
	Console.Println("\(pair(A, X))")
}
