package demo

import "timeout"

func pause() string uses Scheduler {
	Scheduler.Sleep(1ms)
	return "slept"
}

func nap() (string, error[timeout.Expired]) uses Scheduler {
	v := try timeout.After(1s) { pause() }
	return v
}

func main() uses Console {
	v := with(wire{ Scheduler = LiveScheduler{} }) { nap() } catch {
	case timeout.Expired:
		"timed out"
	}
	Console.Println(v)
}
