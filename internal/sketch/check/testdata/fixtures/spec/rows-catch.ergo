import timeout

type OrderNotFound { ID string }
type GatewayDown {}

type Order {
	ID    string,
	Total int64,
}

type Orders {
	Find(id string) Order fails OrderNotFound,
}

type Gateway {
	Charge(order Order) string fails GatewayDown,
}

type MemoryOrders {}

func Find(_ MemoryOrders, id string) Order fails OrderNotFound {
	return Order{ID: id, Total: 1999}
}

type FakeGateway { AuthID string }

func Charge(g FakeGateway, order Order) string fails GatewayDown {
	return g.AuthID
}

let Live = wire {
	Orders:    MemoryOrders{},
	Gateway:   FakeGateway{AuthID: "auth-7"},
	Scheduler: LiveScheduler{},
}

func checkout(id string) string fails OrderNotFound | GatewayDown | timeout.Expired needs Orders, Gateway, Scheduler {
	let order = try Orders.Find(id)
	return Gateway.Charge(order)
}

func demo(id string) string needs Orders {
	let outcome = with Live { checkout(id) } catch {
	case OrderNotFound:
		"no such order"
	case GatewayDown, timeout.Expired:
		"gateway unavailable"
	}

	let order = try Orders.Find(id) catch {
	case OrderNotFound:
		Order{ID: id}
	} // any other failure of Find escapes through try
	return outcome + order.ID
}

func main() {}
