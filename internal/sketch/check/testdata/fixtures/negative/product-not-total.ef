package demo

type A struct{}
type B struct{}
type X struct{}
type Y struct{}
type AB interface{ A | B }
type XY interface{ X | Y }

func label(a A, b X) string { return "ax" }

func pair(p AB, q XY) string {
	switch a, b := p.(type), q.(type) { // want S103
	case (A, X):
		return label(a, b)
	case (B, Y):
		return "by"
	}
	return "other"
}

func main() {}
