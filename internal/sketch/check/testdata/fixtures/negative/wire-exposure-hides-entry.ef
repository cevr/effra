package demo

type Store interface{ Label() string }
type Account interface{ Label() string }
type Memory struct{ Text string }

func (m Memory) Label() string { return m.Text }

wire App provides Account { // want S109
	Store   = Memory{Text: "hidden"}
	Account = Memory{Text: "shown"}
}

func main() needs Console {
	Console.Println(with(App) { Store.Label() })
}
