// 196p rule 3: `Declined{Reason: CardExpired}` is not covered (S103).
type Reason = Fraud{Rule string} | CardExpired{}
type Payment = Pending{} | Declined{Reason Reason}

func label(p Payment) string {
	match p { // want S103
	case Pending:
		return "waiting"
	case Declined{Reason: Fraud{Rule: r}}:
		return r
	}
}
