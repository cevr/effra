// 196t: one result, which may be a tuple; tuple values, tuple types and
// destructuring. A record field of tuple type names the tuple.
type Span (int, int)

type Window { Bounds Span }

func DivMod(a, b int) (int, int) {
	return (a / b, a % b)
}

func width(w Window) int {
	let (lo, hi) = w.Bounds
	return hi - lo
}

func sum() int {
	let q, r = DivMod(7, 2)
	let pair (int, string) = (q, "x")
	let (n, s) = pair
	if s == "x" {
		return n + r + width(Window{Bounds: Span((1, 4))})
	}
	return q
}
