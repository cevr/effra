// 196r: a function body yields its last expression; `return` stays for an
// early exit; a tail `if`/`else` or a total `match` yields the arm's value.
type Payment = Pending{} | Authorized{AuthID string}

func add(a, b int) int {
	a + b
}

func sign(n int) int {
	if n < 0 { -1 } else if n == 0 { 0 } else { 1 }
}

func early(n int) int {
	if n < 0 {
		return 0
	}
	n
}

func label(p Payment) string {
	match p {
	case Pending:
		"waiting"
	case Authorized{AuthID: id}:
		id
	}
}
