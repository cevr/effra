let Base = wire provides Accounts needs Clock {
	Accounts: MemoryAccounts{},
}

let Test = wire {
	Base,
	replace Accounts: FakeAccounts{},
	Ledger, Audit: Recorder{},
}

func main() needs Console {
	with wire { Console: Quiet{} } { Console.Println("x") }
	let local = wire { Clock: Fixed{} }
	with Test, local {
		Console.Println("y")
	}
}
