package wordcount

import (
	"cmp"
	"fs"
	"os"
	"slices"
	"strings"
)

type WordCount struct {
	Word  string
	Count int
}

// Lines opens the file and closes it when the loop ends, on every exit.
func topWords(path string, n int) ([]WordCount, error[fs.NotFound | fs.ReadFailed]) needs fs.Files {
	var counts map[string]int
	for line := range try Files.Lines(path) {
		for _, w := range strings.Fields(strings.ToLower(line)) {
			counts[w]++
		}
	}
	var words []WordCount
	for w, c := range counts {
		words = append(words, WordCount{w, c})
	}
	slices.SortFunc(words, func(a, b) int {
		return cmp.Or(cmp.Compare(b.Count, a.Count), strings.Compare(a.Word, b.Word))
	})
	return words[:min(n, len(words))]
}

func main() error[fs.NotFound | fs.ReadFailed] needs fs.Files, os.Args, Console {
	words := try topWords(Args.Get(1), 5)
	for _, w := range words {
		Console.Println(w.Word, w.Count)
	}
}
