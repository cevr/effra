package app

import (
	"retry"
	"sql"
	"time"
)

type ConnectFailed struct{ URL string }
type CloseFailed struct{}
type OrderNotFound struct{ ID string }

type Config interface {
	String(key string) string
}

type Orders interface {
	Find(id string) (Order, error[OrderNotFound])
}

// Postgres owns a connection pool and a background task.
type Postgres struct {
	pool    sql.Pool
	refresh Task[struct{}] // a provider may own tasks; Close must consume them
}

func (p Postgres) Find(id string) (Order, error[OrderNotFound]) {
	return p.pool.QueryOrder(id)
}

// A provider with Close is a resource (io.Closer). wire calls Close when the
// build is released, dependents first, even under interruption.
func (p Postgres) Close() error[CloseFailed] {
	p.refresh.Stop()
	return p.pool.Close()
}

// A constructor is an ordinary function. Its needs row is resolved from the
// same wire graph, and its error row joins the startup errors of every with().
func OpenPostgres() (Postgres, error[ConnectFailed]) needs Config, Clock, Scheduler {
	url := Config.String("DATABASE_URL")
	pool := try retry.On[ConnectFailed](retry.Exponential(200ms).Times(5)) { sql.Open(url) }
	return Postgres{pool, go keepWarm(pool)}
}

func keepWarm(pool sql.Pool) needs Clock {
	for range Clock.Tick(30s) {
		pool.Ping()
	}
}

// The constructor picks an implementation at build time, as Effect's
// Layer.unwrapEffect does. wire closes whichever value it returned if that
// value has a Close method.
func OpenOrders() (Orders, error[ConnectFailed]) needs Config, Clock, Scheduler {
	if Config.String("ORDERS") == "memory" {
		return MemoryOrders{}
	}
	return try OpenPostgres()
}

wire Live provides Orders {
	Config = EnvConfig{}
	Orders = OpenOrders // effectful: runs during the build
}

// Built once for the whole server, not per request.
func main() error[ConnectFailed | CloseFailed] needs Clock, Scheduler, Console {
	return with(Live) {
		serve(time.Minute)
	}
}
