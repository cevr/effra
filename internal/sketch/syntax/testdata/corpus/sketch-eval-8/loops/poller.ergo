import time
import timeout

type SourceDown {}
type FlushFailed {}

type Reading {
	At    time.Time,
	Value float64,
}

type Source {
	Read() float64 fails SourceDown,
}

type Sink {
	Flush(batch []Reading) fails FlushFailed,
}

// The ticker stops when the loop ends. A full queue blocks the push.
func poll(out queue.Queue[Reading]) needs Source, Clock, Console {
	for at in Clock.Tick(1s) {
		let v = Source.Read() catch {
		case SourceDown:
			Console.Println("poll failed")
			continue
		}
		out.Push(Reading{at, v})
	}
}

func batch(in2 queue.Queue[Reading], size int) fails FlushFailed needs Sink {
	let mut buf []Reading
	for r in in2.Values() {
		buf = buf.Append(r)
		if len(buf) == size {
			try Sink.Flush(buf)
			buf = buf[:0]
		}
	}
	if len(buf) > 0 {
		try Sink.Flush(buf)
	}
}

// A flush failure exits Run, and that exit stops the producer.
func Run(d time.Duration) fails FlushFailed needs Source, Sink, Clock, Scheduler, Console {
	let ch = queue.New[Reading](16)
	let producer = task.Go() {
		scope.OnExit() { ch.Close() }
		timeout.After(d) { poll(ch) } catch {
		case timeout.Expired:
		}
	}
	try batch(ch, 5)
	producer.Wait()
}
