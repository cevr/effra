package tasks

// Map is library code, not a construct. It keeps input order and runs at
// most limit calls at once. It waits for whichever task finishes first, so a
// failure is seen as soon as it happens. Map then exits, and the exit stops
// and drains every task still running.
func Map(xs []A, limit int, f func(A) (B, error[E]) needs R) ([]B, error[E]) needs R {
	out := make([]B, len(xs))
	running := map[int]Task[B, E]{}
	done := make(chan int, len(xs))
	for i, x := range xs {
		if len(running) == limit {
			j := <-done
			out[j] = try running[j].Wait()
			delete(running, j)
		}
		running[i] = go {
			defer done <- i
			f(x)
		}
	}
	for len(running) > 0 {
		j := <-done
		out[j] = try running[j].Wait()
		delete(running, j)
	}
	return out
}
