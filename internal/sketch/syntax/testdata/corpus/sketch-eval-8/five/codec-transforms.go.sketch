package orders

import (
	"json"
	"testing"
)

// Transformed JSON codecs: a pure nominal conversion, a normalizing codec,
// a refinement that rejects in both directions, and an effectful conversion
// whose decode and encode directions need different services.
//
// A type's wire form is found by name, as Go finds Test and Fuzz functions:
// ParseX(w) decodes and x.Wire() encodes (Go's netip.ParseAddr and String pair).
// Their error and uses rows join every codec that contains X.

type InvalidQuantity struct{ Units int64 }
type UnknownMember struct{ Handle string }
type DirectoryDown struct{}
type AuditRefused struct{ Handle string }

// A nominal identifier: the wire carries a plain string.
type UserId struct{ value string }

func ParseUserId(s string) UserId { return UserId{s} }
func (id UserId) Wire() string    { return id.value }

// A normalizing codec: the legacy Enabled spelling decodes as Active. Status
// is a subset of StatusWire, so encoding needs no Wire method and always
// writes the canonical spelling.
type Status interface{ Active | Suspended }
type StatusWire interface{ Active | Enabled | Suspended }

type Active struct{}
type Enabled struct{}
type Suspended struct{}

func ParseStatus(w StatusWire) Status {
	switch w.(type) {
	case Active, Enabled:
		return Active{}
	case Suspended:
		return Suspended{}
	}
}

// A refinement. The field is unexported, so code outside this package can
// build a Quantity only through ParseQuantity: parse, don't validate.
type Quantity struct{ units int64 }

func ParseQuantity(units int64) (Quantity, error[InvalidQuantity]) {
	if units < 0 {
		return InvalidQuantity{units}
	}
	return Quantity{units}
}

func (q Quantity) Wire() (int64, error[InvalidQuantity]) {
	if q.units < 0 {
		return InvalidQuantity{q.units}
	}
	return q.units
}

// An effectful conversion with direction-specific services.
type Member struct {
	Handle  string
	Sponsor UserId
}

type MemberWire struct {
	Handle  string
	Sponsor UserId
}

type Directory interface {
	Known(handle string) (bool, error[DirectoryDown])
}

type Audit interface {
	Note(handle string) error[AuditRefused]
}

func ParseMember(w MemberWire) (Member, error[UnknownMember | DirectoryDown]) uses Directory {
	if !try Directory.Known(w.Handle) {
		return UnknownMember{w.Handle}
	}
	return Member{w.Handle, w.Sponsor}
}

func (m Member) Wire() (MemberWire, error[AuditRefused]) uses Audit {
	try Audit.Note(m.Handle)
	return MemberWire{m.Handle, m.Sponsor}
}

// A parent's codec composes its fields' wire forms; no witness list.
type Order struct {
	Buyer    UserId
	Member   Member
	Quantity Quantity
	Status   Status
}

type Settings struct {
	Owner         UserId
	DefaultStatus Status
}

// Decode checks the whole structure before any Parse runs, so malformed
// input never reaches a service. ef inspect orderJSON shows the resolved tree.
var orderJSON = json.Codec[Order]{MaxBytes: 4096, MaxDepth: 3}
var settingsJSON = json.Codec[Settings]{MaxBytes: 512, MaxDepth: 2}

type Env interface{ Get(name string) string }

func reencodeOrder(stored string) (string, error[json.DecodeFailed | json.EncodeFailed | InvalidQuantity | UnknownMember | DirectoryDown | AuditRefused]) uses Directory, Audit {
	order := try orderJSON.Decode(stored)
	return orderJSON.Encode(order)
}

func loadSettings() (Settings, error[json.DecodeFailed]) uses Env {
	return settingsJSON.Decode(Env.Get("ORDER_SETTINGS"))
}

type Members struct{}

func (Members) Known(handle string) (bool, error[DirectoryDown]) { return handle != "ghost" }

type Outage struct{}

func (Outage) Known(handle string) (bool, error[DirectoryDown]) { return DirectoryDown{} }

type Ledger struct{}

func (Ledger) Note(handle string) error[AuditRefused] {
	if handle == "sealed" {
		return AuditRefused{handle}
	}
}

type StoredSettings struct{}

func (StoredSettings) Get(name string) string {
	return `{"owner":"u-1","defaultStatus":{"_tag":"Enabled"}}`
}

wire Healthy {
	Directory = Members{}
	Audit = Ledger{}
}

wire Down {
	Directory = Outage{}
	Audit = Ledger{}
}

var stored = `{"buyer":"u-7","member":{"handle":"ada","sponsor":"u-1"},"quantity":"3","status":{"_tag":"Enabled"}}`

func TestNominalRoundTrips() error[json.DecodeFailed | json.EncodeFailed] uses testing.T {
	id := try json.Decode[UserId](`"u-42"`)
	T.Equal(id.Wire(), "u-42")
	T.Equal(try json.Encode(id), `"u-42"`)
}

func TestNormalizingCanonicalizes() error[json.DecodeFailed | json.EncodeFailed] uses testing.T {
	legacy := try json.Decode[Status](`{"_tag":"Enabled"}`)
	T.Equal(try json.Encode(legacy), `{"_tag":"Active"}`)
	suspended := try json.Decode[Status](try json.Encode(Suspended{}))
	T.Equal(suspended, Suspended{})
}

func TestRefinementRejectsOnDecode() error[json.DecodeFailed] uses testing.T {
	refused := json.Decode[Quantity](`"-1"`) catch {
	case InvalidQuantity:
		Quantity{99}
	}
	T.Equal(refused, Quantity{99})
}

func TestEncodeSideRejection() error[json.EncodeFailed] uses testing.T {
	written := json.Encode(Quantity{-5}) catch {
	case InvalidQuantity:
		"refused"
	}
	T.Equal(written, "refused")
}

func TestNestedRoundTrip() error[json.DecodeFailed | json.EncodeFailed | InvalidQuantity | UnknownMember | DirectoryDown | AuditRefused] uses testing.T {
	written := try with(Healthy) { reencodeOrder(stored) }
	T.Equal(written, `{"buyer":"u-7","member":{"handle":"ada","sponsor":"u-1"},"quantity":"3","status":{"_tag":"Active"}}`)
}

func TestNestedFailureKeepsItsType() error[json.DecodeFailed | json.EncodeFailed | InvalidQuantity | DirectoryDown | AuditRefused] uses testing.T {
	ghost := `{"buyer":"u-7","member":{"handle":"ghost","sponsor":"u-1"},"quantity":"1","status":{"_tag":"Active"}}`
	outcome := try with(Healthy) { reencodeOrder(ghost) } catch {
	case UnknownMember:
		"unknown member"
	}
	T.Equal(outcome, "unknown member")
}

func TestMalformedInputNeverReachesAService() error[json.EncodeFailed | InvalidQuantity | UnknownMember | DirectoryDown | AuditRefused] uses testing.T {
	malformed := `{"buyer":"u-7","member":{"handle":"ada","sponsor":"u-1"},"quantity":3,"status":{"_tag":"Active"}}`
	outcome := try with(Down) { reencodeOrder(malformed) } catch {
	case json.DecodeFailed:
		"malformed"
	}
	T.Equal(outcome, "malformed")
}

func TestServiceFailureIsNotMalformedInput() error[json.DecodeFailed | json.EncodeFailed | InvalidQuantity | UnknownMember | AuditRefused] uses testing.T {
	outcome := try with(Down) { reencodeOrder(stored) } catch {
	case DirectoryDown:
		"directory down"
	}
	T.Equal(outcome, "directory down")
}

// Encoding needs Audit and never Directory: the row says so.
func TestEncodeRunsOnlyEncodeServices() error[json.EncodeFailed | InvalidQuantity] uses testing.T {
	order := Order{UserId{"u-7"}, Member{"sealed", UserId{"u-1"}}, Quantity{1}, Active{}}
	outcome := try with(wire{ Audit = Ledger{} }) { orderJSON.Encode(order) } catch {
	case AuditRefused:
		"audit refused"
	}
	T.Equal(outcome, "audit refused")
}

func TestConfigurationSharesTheWireForms() error[json.DecodeFailed | json.EncodeFailed] uses testing.T {
	settings := try with(wire{ Env = StoredSettings{} }) { loadSettings() }
	T.Equal(try settingsJSON.Encode(settings), `{"owner":"u-1","defaultStatus":{"_tag":"Active"}}`)
}

func main() (string, error[json.DecodeFailed | json.EncodeFailed | InvalidQuantity | UnknownMember | DirectoryDown | AuditRefused]) {
	order := try with(Healthy) { reencodeOrder(stored) }
	settings := try with(wire{ Env = StoredSettings{} }) { loadSettings() }
	return order + " " + try settingsJSON.Encode(settings)
}
