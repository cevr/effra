package layers

// Capability identity is the interface name, so these three stay distinct.
type Store interface{ Label() string }
type Account interface{ Label() string }
type Invoice interface{ Label() string }

type Memory struct{ Text string }

func (m Memory) Label() string { return m.Text }

type AccountLive struct{ Store Store } // capability field: filled by wire

func (a AccountLive) Label() string { return a.Store.Label() }

type InvoiceLive struct{ Store Store }

func (i InvoiceLive) Label() string { return i.Store.Label() }

wire Shared {
	Store = Memory{Text: "live"}
}

wire Accounts {
	Shared
	Account = AccountLive
}

wire Invoices {
	Shared
	Invoice = InvoiceLive
}

wire App provides Account, Invoice { // exposes two; Store stays hidden, built once
	Accounts
	Invoices
}

wire Fixture {
	App
	replace Store = Memory{Text: "fixture"}
}

func labels() string needs Account, Invoice {
	return Account.Label() + ":" + Invoice.Label()
}

func main() string {
	return with(Fixture, labels)
}
