import task
import timeout

type Bad {}

func immediate() string {
	return "child joined"
}

func pending() string needs Clock {
	Clock.Sleep(10s)
	return "late"
}

func bad() string fails Bad {
	return Bad{}
}

// Every task is consumed by Wait or Stop before the function returns.
func program() fails Bad needs Clock, Console, Scheduler {
	let child = task.Go() { immediate() }
	Console.Println(child.Wait())

	let stopped = task.Go() { pending() }
	stopped.Stop() // interrupts it and waits for its cleanup

	let deadline = timeout.After(1ms, pending) catch {
	case timeout.Expired:
		"timed out"
	}
	Console.Println(deadline)

	let failed = task.Go() { bad() }
	let recovered = failed.Wait() catch {
	case Bad:
		"recovered"
	}
	Console.Println(recovered)
	return
}

func main() fails Bad needs Clock, Console, Scheduler {
	return program()
}
