import json
import testing

// Transformed JSON codecs: a pure nominal conversion, a normalizing codec,
// a refinement that rejects in both directions, and an effectful conversion
// whose decode and encode directions need different services.
//
// A type's wire form is found by name, as Go finds Test and Fuzz functions:
// ParseX(w) decodes and x.Wire() encodes (Go's netip.ParseAddr and String pair).
// Their error and needs rows join every codec that contains X.

type InvalidQuantity { Units int64 }
type UnknownMember { Handle string }
type DirectoryDown {}
type AuditRefused { Handle string }

// A nominal identifier: the wire carries a plain string.
type UserId { value string }

func ParseUserId(s string) UserId { return UserId{s} }
func Wire(id UserId) string       { return id.value }

// A normalizing codec: the legacy Enabled spelling decodes as Active. Status
// is a subset of StatusWire, so encoding needs no Wire method and always
// writes the canonical spelling.
type Status = Active | Suspended
type StatusWire = Active | Enabled | Suspended

type Active {}
type Enabled {}
type Suspended {}

func ParseStatus(w StatusWire) Status {
	match w {
	case Active, Enabled:
		return Active{}
	case Suspended:
		return Suspended{}
	}
}

// A refinement. The field is unexported, so code outside this package can
// build a Quantity only through ParseQuantity: parse, don't validate.
type Quantity { units int64 }

func ParseQuantity(units int64) Quantity fails InvalidQuantity {
	if units < 0 {
		return InvalidQuantity{units}
	}
	return Quantity{units}
}

func Wire(q Quantity) int64 fails InvalidQuantity {
	if q.units < 0 {
		return InvalidQuantity{q.units}
	}
	return q.units
}

// An effectful conversion with direction-specific services.
type Member {
	Handle  string,
	Sponsor UserId,
}

type MemberWire {
	Handle  string,
	Sponsor UserId,
}

type Directory {
	Known(handle string) bool fails DirectoryDown,
}

type Audit {
	Note(handle string) fails AuditRefused,
}

func ParseMember(w MemberWire) Member fails UnknownMember | DirectoryDown needs Directory {
	if try !Directory.Known(w.Handle) {
		return UnknownMember{w.Handle}
	}
	return Member{w.Handle, w.Sponsor}
}

func Wire(m Member) MemberWire fails AuditRefused needs Audit {
	try Audit.Note(m.Handle)
	return MemberWire{m.Handle, m.Sponsor}
}

// A parent's codec composes its fields' wire forms; no witness list.
type Order {
	Buyer    UserId,
	Member   Member,
	Quantity Quantity,
	Status   Status,
}

type Settings {
	Owner         UserId,
	DefaultStatus Status,
}

// Decode checks the whole structure before any Parse runs, so malformed
// input never reaches a service. ef inspect orderJSON shows the resolved tree.
let orderJSON = json.Codec[Order]{MaxBytes: 4096, MaxDepth: 3}
let settingsJSON = json.Codec[Settings]{MaxBytes: 512, MaxDepth: 2}

type Env { Get(name string) string }

func reencodeOrder(stored string) string fails json.DecodeFailed | json.EncodeFailed | InvalidQuantity | UnknownMember | DirectoryDown | AuditRefused needs Directory, Audit {
	let order = try orderJSON.Decode(stored)
	return orderJSON.Encode(order)
}

func loadSettings() Settings fails json.DecodeFailed needs Env {
	return settingsJSON.Decode(Env.Get("ORDER_SETTINGS"))
}

type Members {}

func Known(_ Members, handle string) bool fails DirectoryDown { return handle != "ghost" }

type Outage {}

func Known(_ Outage, handle string) bool fails DirectoryDown { return DirectoryDown{} }

type Ledger {}

func Note(_ Ledger, handle string) fails AuditRefused {
	if handle == "sealed" {
		return AuditRefused{handle}
	}
}

type StoredSettings {}

func Get(_ StoredSettings, name string) string {
	return `{"owner":"u-1","defaultStatus":{"_tag":"Enabled"}}`
}

let Healthy = wire {
	Directory: Members{},
	Audit:     Ledger{},
}

let Down = wire {
	Directory: Outage{},
	Audit:     Ledger{},
}

let stored = `{"buyer":"u-7","member":{"handle":"ada","sponsor":"u-1"},"quantity":"3","status":{"_tag":"Enabled"}}`

test NominalRoundTrips {
	let id = try json.Decode[UserId](`"u-42"`)
	assert id.Wire() == "u-42"
	assert try json.Encode(id) == `"u-42"`
}

test NormalizingCanonicalizes {
	let legacy = try json.Decode[Status](`{"_tag":"Enabled"}`)
	assert try json.Encode(legacy) == `{"_tag":"Active"}`
	let suspended = try json.Decode[Status](try json.Encode(Suspended{}))
	assert suspended == Suspended{}
}

test RefinementRejectsOnDecode {
	let refused = json.Decode[Quantity](`"-1"`) catch {
	case InvalidQuantity:
		Quantity{99}
	}
	assert refused == Quantity{99}
}

test EncodeSideRejection {
	let written = json.Encode(Quantity{-5}) catch {
	case InvalidQuantity:
		"refused"
	}
	assert written == "refused"
}

test NestedRoundTrip {
	let written = try with Healthy { reencodeOrder(stored) }
	assert written == `{"buyer":"u-7","member":{"handle":"ada","sponsor":"u-1"},"quantity":"3","status":{"_tag":"Active"}}`
}

test NestedFailureKeepsItsType {
	let ghost = `{"buyer":"u-7","member":{"handle":"ghost","sponsor":"u-1"},"quantity":"1","status":{"_tag":"Active"}}`
	let outcome = try with Healthy { reencodeOrder(ghost) } catch {
	case UnknownMember:
		"unknown member"
	}
	assert outcome == "unknown member"
}

test MalformedInputNeverReachesAService {
	let malformed = `{"buyer":"u-7","member":{"handle":"ada","sponsor":"u-1"},"quantity":3,"status":{"_tag":"Active"}}`
	let outcome = try with Down { reencodeOrder(malformed) } catch {
	case json.DecodeFailed:
		"malformed"
	}
	assert outcome == "malformed"
}

test ServiceFailureIsNotMalformedInput {
	let outcome = try with Down { reencodeOrder(stored) } catch {
	case DirectoryDown:
		"directory down"
	}
	assert outcome == "directory down"
}

// Encoding needs Audit and never Directory: the row says so.
test EncodeRunsOnlyEncodeServices {
	let order = Order{UserId{"u-7"}, Member{"sealed", UserId{"u-1"}}, Quantity{1}, Active{}}
	let outcome = try with wire { Audit: Ledger{} } { orderJSON.Encode(order) } catch {
	case AuditRefused:
		"audit refused"
	}
	assert outcome == "audit refused"
}

test ConfigurationSharesTheWireForms {
	let settings = try with wire { Env: StoredSettings{} } { loadSettings() }
	assert try settingsJSON.Encode(settings) == `{"owner":"u-1","defaultStatus":{"_tag":"Active"}}`
}

func main() string fails json.DecodeFailed | json.EncodeFailed | InvalidQuantity | UnknownMember | DirectoryDown | AuditRefused {
	let order = try with Healthy { reencodeOrder(stored) }
	let settings = try with wire { Env: StoredSettings{} } { loadSettings() }
	return try order + " " + settingsJSON.Encode(settings)
}
