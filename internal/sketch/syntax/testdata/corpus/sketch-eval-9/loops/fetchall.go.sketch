package fetchall

import (
	"http"
	"os"
	"retry"
	"tasks"
	"timeout"
)

type Unauthorized struct{}
type Failed struct{ Status int }

type Result struct {
	URL   string
	Bytes Option[int] // None when every attempt failed
}

// The deadline covers the headers and the body, as Go's context timeout does.
func fetchOnce(url string) (int, error[Unauthorized | Failed | timeout.Expired]) uses http.Client, Scheduler {
	return timeout.After(2s) { get(url) }
}

// Get returns after the headers. resp is a linear resource: the checker
// rejects get unless every path closes or moves it.
func get(url string) (int, error[Unauthorized | Failed]) uses http.Client {
	resp := try Client.Get(url)
	defer resp.Close()
	if resp.Status == 401 {
		return Unauthorized{}
	}
	if resp.Status >= 500 {
		return Failed{resp.Status}
	}
	body := try resp.ReadAll()
	return len(body)
}

// retry.On retries only the listed errors; Unauthorized passes straight through.
func fetch(url string) (Result, error[Unauthorized]) uses http.Client, Scheduler {
	n := try retry.On[Failed | timeout.Expired](retry.Exponential(100ms).Times(3)) { fetchOnce(url) } catch {
	case Failed, timeout.Expired:
		return Result{URL: url}
	}
	return Result{url, Some{n}}
}

// The first Unauthorized exits fetchAll, and that exit stops the fetches still running.
func fetchAll(urls []string) ([]Result, error[Unauthorized]) uses http.Client, Scheduler {
	return tasks.Map(urls, 8, fetch)
}

func main() error[Unauthorized] uses http.Client, os.Args, Scheduler, Console {
	results := try fetchAll(Args.Rest())
	ok, total := 0, 0
	for _, r := range results {
		if n, found := r.Bytes.Get(); found {
			ok++
			total += n
		}
	}
	Console.Println(ok, "ok,", len(results)-ok, "failed,", total, "bytes")
}
