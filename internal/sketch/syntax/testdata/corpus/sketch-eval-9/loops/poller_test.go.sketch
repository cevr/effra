package poller

import (
	"sync"
	"testing"
)

type Recorded interface {
	Sizes() []int
}

type Constant struct{ Value float64 }

func (c Constant) Read() (float64, error[SourceDown]) {
	return c.Value
}

// sync.Ref is a shareable mutable cell; each wire build gets a fresh one.
type Recorder struct{ sizes sync.Ref[[]int] }

func (r Recorder) Flush(batch []Reading) error[FlushFailed] {
	r.sizes.Update(func(s *[]int) { *s = append(*s, len(batch)) })
}

func (r Recorder) Sizes() []int {
	return r.sizes.Load()
}

// VirtualClock provides Clock and Scheduler. Virtual time jumps to the next
// timer when every task waits, as Go's testing/synctest does.
wire TestLive {
	Clock, Scheduler = testing.VirtualClock{}
	Source = Constant{Value: 1}
	Sink, Recorded = Recorder{}
	Console = testing.Discard{}
}

func TestRunBatches() error[FlushFailed] uses testing.T {
	with(TestLive) {
		try Run(10500ms)
		T.Equal(Recorded.Sizes(), []int{5, 5})
	}
}
