package tasks

// Map is library code, not a construct. It keeps input order and runs at
// most limit calls at once (limit must be at least 1). After the first window
// fills, it waits for whichever task finishes first, so a failure is seen
// when that task ends. Map then exits, and the exit stops and drains every
// task still running.
func Map(xs []A, limit int, f func(A) (B, error[E]) needs R) ([]B, error[E]) needs R {
	slots := make([]Option[B], len(xs)) // Option is defaultable; B may not be
	running := map[int]Task[B, E]{}
	done := make(chan int, len(xs))
	for i, x := range xs {
		if len(running) == limit {
			j := <-done
			slots[j] = Some{try running.Take(j).Wait()}
		}
		running[i] = go {
			defer done <- i
			f(x)
		}
	}
	for len(running) > 0 {
		j := <-done
		slots[j] = Some{try running.Take(j).Wait()}
	}
	return options.Values(slots) // every slot is Some here
}
