import go github.com/PuerkitoBio/goquery // a Go package, mapped conservatively
import go net/url
import strings

type BadURL { Raw string }

// Level 2: a typed binding. A bodiless declaration with an //ef:go directive
// binds one Go function precisely, as Go binds assembly with a bodiless func.
// The generated adapter checks the claims at the boundary: a nil URL where
// the declaration says URL, or a panic, becomes a defect, never a nil value.
//
extern go net/url.Parse func parseURL(raw string) url.URL fails go.Error needs go.Foreign

func absolute(base url.URL, href string) string fails BadURL needs go.Foreign {
	let ref = parseURL(href) catch {
	case go.Error:
		return BadURL{href}
	}
	return base.ResolveReference(ref).String()
}

// Level 1: the whole package, imported with conservative types. A Go result
// that may be nil arrives as Option. A Go (T, error) arrives as
// (T, error[go.Error]). A Go slice or map is copied at the boundary, so value
// semantics hold. Go code that takes a context.Context receives this task's
// interruption as cancellation; a blocking Go call without one is listed by
// ef inspect as an uninterruptible host wait.
func links(page string, base url.URL) []string fails go.Error | BadURL needs go.Foreign {
	let doc = try goquery.NewDocumentFromReader(strings.NewReader(page))
	let mut out []string
	for a in doc.Find("a[href]").Nodes() {
		let href, ok = a.Attr("href").Get()
		if ok {
			out = out.Append(try absolute(base, href))
		}
	}
	return out
}
