import log
import net
import schedule
import tasks
import trace

// with scopes context values as well as wires. A context value is immutable,
// and every task started inside inherits it (Java ScopedValue, Effect References).
func main() fails net.ListenFailed needs net.Listener, Console, Clock, Scheduler {
	return with trace.Span("ingest"), log.Annotate("region", "eu") {
		// A tasks.Set owns an unbounded number of tasks and drops finished
		// ones. Set.Go takes a func literal: the Set keeps it after Go returns.
		// A connection is moved into its task, so a failed handler is not
		// restarted: a restart policy needs a reusable factory with no linear
		// captures (Erlang one_for_one restarts from the child spec).
		let conns = tasks.Set(tasks.LogFailures)
		// conns is a resource: it is stopped when this with block ends, inside the span.
		for conn in try Listener.Accept(":9000") {
			conns.Go(func() {
				with log.Annotate("peer", conn.Peer()) { handle(conn) }
			})
		}
	}
}

func handle(conn net.Conn) needs Console {
	for line in conn.Lines() {
		log.Info("line", "bytes", len(line)) // carries span, region and peer
	}
}

// A defect prints the chain of tasks that led to it (fork tree), with spans:
//
//   defect: index out of range [3] with length 3
//     at handle (ingest.ef:31)
//     task #7 handle, started by tasks.Set #2 at main (ingest.ef:24)
//       span ingest  region=eu  peer=10.0.0.4
//     task #1 main
//
// ef ps <pid> shows the live task tree, for people and agents:
//
//   #1 main                          running   span ingest region=eu
//   └─ #2 tasks.Set                  policy log-failures, 1 failed
//      ├─ #7 handle peer=10.0.0.4   waiting   conn read (12ms)
//      └─ #9 handle peer=10.0.0.9   waiting   conn read (2s)
