import batch
import sql
import sync
import tasks

type Insufficient {}

// Accounts live in TxRefs. Load and Store need the sync.Tx capability, which
// only sync.Atomically provides. A transaction can re-run, so its parameter
// is replayable: its footprint may hold nothing but sync.Tx, and it may not
// assign captured locals, use channels or consume linear values.
func move(from, to sync.TxRef[int64], amount int64) fails Insufficient needs sync.Tx {
	if from.Load() < amount {
		return Insufficient{}
	}
	from.Store(from.Load() - amount)
	to.Store(to.Load() + amount)
}

// One transaction: no locks, no deadlocks. Two moves compose into one
// atomic step without either knowing about the other.
func transfer(a, b, c sync.TxRef[int64], amount int64) fails Insufficient {
	return sync.Atomically() {
		try move(a, b, amount)
		move(b, c, amount)
	}
}

// sync.Retry blocks the transaction, without polling, until a TxRef it read
// changes (Haskell STM retry).
func withdrawWhenFunded(acct sync.TxRef[int64], amount int64) {
	sync.Atomically() {
		if acct.Load() < amount {
			sync.Retry()
		}
		acct.Store(acct.Load() - amount)
	}
}

// Request batching. The provider implements the batched form; wire wraps it
// with batch.Resolve. Go has no scheduler tick to batch on, so the policy is
// explicit, as DataLoader's is: a batch closes after the window or at the
// size limit. Duplicate ids share one result. A waiter that is stopped leaves
// the batch, and the batch is cancelled when no waiter is left.
type NotFound { ID string }

type User {
	ID   string,
	Name string,
}

type Users {
	Find(id string) User fails NotFound,
}

type UsersDB { Pool sql.Pool }

func FindMany(u UsersDB, ids []string) Map[string, Option[User]] {
	return u.Pool.UsersByID(ids)
}

let Live = wire {
	Users: batch.Resolve(UsersDB, batch.Window(2ms), batch.Max(100)),
}

// 100 concurrent Find calls: one query when all arrive within the window.
func names(ids []string) []string fails NotFound needs Users {
	return tasks.Map(ids, 100, func(id string) string fails NotFound {
		let u = try Users.Find(id)
		return u.Name
	})
}
