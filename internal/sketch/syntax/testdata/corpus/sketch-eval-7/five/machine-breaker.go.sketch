package breaker

type ProbeUnavailable struct{}

type Probe interface {
	Healthy(endpoint string) (bool, error[ProbeUnavailable])
}

type HealthyProbe struct{}

func (HealthyProbe) Healthy(endpoint string) (bool, error[ProbeUnavailable]) {
	return endpoint == "primary"
}

type Breaker enum {
	Closed{ Failures int64 }
	Open{ Endpoint string }
	HalfOpen{ Endpoint string }
}

type Signal enum {
	Failure{ Endpoint string }
	Success
	Retry
	Retire
}

func tripped(endpoint string) Breaker {
	return Open{Endpoint: endpoint}
}

func breakerStep(state Breaker, signal Signal) (Decision[Breaker, string], error[ProbeUnavailable]) uses Probe {
	switch s, e := state.(type), signal.(type) {
	case (Closed, Failure):
		if s.Failures >= 2 {
			return Enter(tripped(e.Endpoint))
		}
		return Stay(Closed{Failures: s.Failures + 1})
	case (Closed, Success):
		return Stay(Closed{Failures: 0})
	case (Closed, Retry), (HalfOpen, Retry):
		return Ignore
	case (Open, Retry):
		if try Probe.Healthy(s.Endpoint) {
			return Enter(HalfOpen{Endpoint: s.Endpoint})
		}
		return Stay(s)
	case (Open, Failure), (HalfOpen, Failure):
		return Enter(tripped(e.Endpoint))
	case (HalfOpen, Success):
		return Enter(Closed{Failures: 0})
	case (Open, Success):
		return Reject
	case (_, Retire):
		return Done("retired")
	}
}

type CircuitBreaker machine[Breaker, Signal] {
	initial Closed{Failures: 0}
	step    breakerStep
}

func describe(d Decision[Breaker, string]) string {
	switch d.(type) {
	case Enter:
		return "enter " + label(d.Next)
	case Stay:
		return "stay " + label(d.Next)
	case Ignore:
		return "ignore"
	case Reject:
		return "reject"
	case Done:
		return "done " + d.Output
	}
}

func label(state Breaker) string {
	switch s := state.(type) {
	case Closed:
		return "closed"
	case Open:
		return "open " + s.Endpoint
	case HalfOpen:
		return "half-open " + s.Endpoint
	}
}

func main() (string, error[ProbeUnavailable]) {
	return with(wire{ Probe = HealthyProbe{} }) {
		open := tripped("primary")
		retried := try breakerStep(open, Retry{})
		failed := try breakerStep(Closed{Failures: 2}, Failure{Endpoint: "primary"})
		retired := try breakerStep(open, Retire{})
		describe(retried) + "; " + describe(failed) + "; " + describe(retired)
	}
}
