package checkout

type OrderNotFound struct{ ID string }
type GatewayDown struct{}

type Order struct {
	ID    string
	Total int64
}

type Payment enum {
	Pending
	Authorized{ AuthID string }
	Declined{ Reason string }
}

type Orders interface {
	Find(id string) (Order, error[OrderNotFound])
}

type Gateway interface {
	Authorize(order Order) (Payment, error[GatewayDown])
}

func checkout(id string) (string, error[OrderNotFound | GatewayDown | Timeout]) uses Orders, Gateway, Scheduler {
	order := try Orders.Find(id)
	payment := try timeout.After(500ms, func() { return Gateway.Authorize(order) })
	switch p := payment.(type) {
	case Pending:
		return "pending"
	case Authorized:
		return "paid " + p.AuthID
	case Declined:
		return "declined: " + p.Reason
	}
}

type MemoryOrders struct{}

func (MemoryOrders) Find(id string) (Order, error[OrderNotFound]) {
	if id == "42" {
		return Order{ID: id, Total: 1999}
	}
	return OrderNotFound{ID: id}
}

type FakeGateway struct{ AuthID string }

func (g FakeGateway) Authorize(order Order) (Payment, error[GatewayDown]) {
	return Authorized{AuthID: g.AuthID}
}

layer Live {
	Orders = MemoryOrders{}
	Gateway = FakeGateway{AuthID: "auth-7"}
	Scheduler = LiveScheduler{}
}

func report(id string) uses Console {
	outcome := provide(Live, func() { return checkout(id) }) catch { // Live lives for this call only
	case OrderNotFound:
		"no such order"
	case GatewayDown:
		"gateway down"
	case Timeout:
		"gateway timed out"
	}
	Console.Log(outcome)
}

func main() {
	provide(layer{ Console = Stdout{} }, func() { report("42") })
	provide(layer{ Console = Stdout{} }, func() { report("7") })
}
