package concurrency

type Bad struct{}

func immediate() string {
	return "child joined"
}

func pending() string needs Clock {
	Clock.Sleep(10s)
	return "late"
}

func bad() (string, error[Bad]) {
	return Bad{}
}

// The function body is the owner block: every child is consumed or awaited before it returns.
func program() error[Bad] needs Clock, Console, Scheduler {
	child := go immediate()
	Console.Log(<-child)

	stopped := go pending()
	stopped.Interrupt() // waits for its cleanup

	deadline := timeout.After(1ms, pending) catch {
	case Timeout:
		"timed out"
	}
	Console.Log(deadline)

	failed := go bad() // fallible: must be consumed exactly once
	recovered := <-failed catch {
	case Bad:
		"recovered"
	}
	Console.Log(recovered)
	return
}

func main() error[Bad] {
	return provide(layer{
		Clock = LiveClock{}
		Console = Stdout{}
		Scheduler = LiveScheduler{}
	}, program)
}
