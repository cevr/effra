package recipes

type Transient struct{}

type Attempt[T] struct {
	Label string
	Work  func() (T, error[Transient]) needs Console // a recipe: runs fresh on every call
}

type RetryPolicy[T] struct {
	Primary Attempt[T]
	Backup  Option[Attempt[T]]
}

func probe(name string) (string, error[Transient]) needs Console {
	Console.Log("probe " + name)
	if name == "flaky" {
		return Transient{}
	}
	return name + " ok"
}

func attempt(item Attempt[string]) string needs Console {
	return item.Work() catch {
	case Transient:
		item.Label + " failed"
	}
}

func retry(policy RetryPolicy[string]) string needs Console {
	first := attempt(policy.Primary)
	switch b := policy.Backup.(type) {
	case None:
		return first
	case Some:
		return first + "; " + attempt(b.V)
	}
}

func main() needs Console {
	policy := RetryPolicy[string]{
		Primary: Attempt[string]{Label: "flaky", Work: func() { return probe("flaky") }},
		Backup:  Some{V: Attempt[string]{Label: "stable", Work: func() { return probe("stable") }}},
	}
	Console.Log("constructed")
	once := retry(policy)
	again := retry(policy)
	Console.Log(once)
	Console.Log(again)
}
