package ledger

type Insufficient struct{ ID string }

type Account struct {
	ID      string
	Balance int64
	History []int64
}

type Transfer struct {
	From, To int
	Amount   int64
}

// var parameters mutate the caller's values in place. No pointers exist.
func move(var from Account, var to Account, amount int64) error[Insufficient] {
	if from.Balance < amount {
		return Insufficient{from.ID}
	}
	from.Balance -= amount
	to.Balance += amount
	from.History.Append(-amount)
	to.History.Append(amount)
}

// Two var borrows into one collection need a proof that they do not overlap.
// Without the From == To guard, the checker rejects the move call.
func apply(var accounts []Account, transfers []Transfer) int {
	var rejected = 0
	for t in transfers {
		if t.From == t.To {
			rejected += 1
			continue
		}
		move(var accounts[t.From], var accounts[t.To], t.Amount) catch {
		case Insufficient:
			rejected += 1
		}
	}
	return rejected
}

func main() needs Console {
	var accounts = []Account{{ID: "a", Balance: 100}, {ID: "b", Balance: 50}}
	before := accounts // a value copy: apply cannot change it
	rejected := apply(var accounts, []Transfer{{0, 1, 30}, {1, 0, 500}, {0, 0, 10}})
	Console.Log(before[0].Balance, accounts[0].Balance, rejected) // 100 70 2
}
