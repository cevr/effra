// The preview's block, with the second comment aligned to the first, as
// gofmt aligns trailing comments (the preview has it one column late).
func total(order Order, fee int64) int64 {
	let Order{Total: base} = order // base cannot be reassigned
	let mut sum = base + fee       // sum can
	if sum > 1000 {
		sum = sum + 5
	}
	let limit int64 = 5000
	sum + limit
}
