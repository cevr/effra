// want S103

type OrderNotFound { ID string }
type GatewayDown {}

type Order {
	ID    string,
	Total int64,
}

type Orders {
	Find(id string) Order fails OrderNotFound,
}

type Gateway {
	Charge(order Order) string fails GatewayDown,
}

type MemoryOrders {}

func Find(_ MemoryOrders, id string) Order fails OrderNotFound {
	if id == "42" {
		return Order{ID: id, Total: 1999}
	}
	return OrderNotFound{ID: id}
}

type FakeGateway {}

func Charge(_ FakeGateway, order Order) string fails GatewayDown {
	return "auth-7"
}

func pay(id string) string fails OrderNotFound | GatewayDown needs Orders, Gateway {
	let order = try Orders.Find(id)
	return Gateway.Charge(order)
}

// A catch with no try must cover every error; GatewayDown is missing.
func main() needs Console {
	let outcome = with wire { Orders: MemoryOrders, Gateway: FakeGateway } { pay("42") } catch {
	case OrderNotFound:
		"no such order"
	}
	Console.Println("\(outcome)")
}
