// out: Console Println with timeout After duration LiveScheduler Scheduler
package demo
type Box struct {
  Console string
  Println string
  with string
  timeout string
  After string
  duration string
  LiveScheduler string
  Scheduler string
}
func main() needs Console {
  value := Box{"Console", "Println", "with", "timeout", "After", "duration", "LiveScheduler", "Scheduler"}
  Console.Println(value.Console, value.Println, value.with, value.timeout, value.After, value.duration, value.LiveScheduler, value.Scheduler)
}
