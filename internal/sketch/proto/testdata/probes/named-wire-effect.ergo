// out: ok
import timeout
type Store { Get() string }
type Holder { Value string }
func Get(h Holder) string { return h.Value }
func build() string {
	return with wire { Scheduler: LiveScheduler{} } {
		timeout.After(1s) { "ok" }
	} catch {
	case timeout.Expired:
		"late"
	}
}
let W = wire { Store: Holder{Value: build()} }
func main() needs Console { Console.Println(with W { Store.Get() }) }
