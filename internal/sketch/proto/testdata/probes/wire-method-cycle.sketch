// want S109
package demo
import "timeout"
type Store interface { Get() string }
type Factory interface { Get() string }
type Holder struct{ Value string }
type Build struct{}
func (h Holder) Get() string { return h.Value }
func (Build) Get() string { return again() }
func again() string { return with(W) { Store.Get() } }
wire W {
  Store = Holder{Value: with(wire{ Factory = Build{} }) { Factory.Get() }}
}
func main() uses Console {
  value := with(wire{ Scheduler = LiveScheduler{} }) {
    timeout.After(1ms) { with(W) { Store.Get() } }
  } catch { case timeout.Expired: "cycle reached runtime" }
  Console.Println(value)
}
