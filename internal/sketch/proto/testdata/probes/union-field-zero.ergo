// want S108
type Fault {}
func unused() fails Fault { return Fault{} }
type A { Value string }
type B {}
type Sum = A | B
type Box { Choice Sum }
func pick(s Sum) string {
	match s {
	case A as v:
		return v.Value
	case B:
		return "b"
	}
}
func main() needs Console {
	let box = Box{}
	Console.Println(pick(box.Choice))
}
