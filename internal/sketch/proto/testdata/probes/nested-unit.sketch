// out: handled
package demo
import "timeout"
type Fault struct{}
func fail() error[Fault] { return Fault{} }
func main() uses Console {
  with(wire{ Scheduler = LiveScheduler{} }) {
    timeout.After(1s) {
      with(wire{ Scheduler = LiveScheduler{} }) {
        try timeout.After(1s) {
          try fail()
          Console.Println("wrong")
        }
      }
    } catch {
    case Fault: Console.Println("handled")
    case timeout.Expired: Console.Println("late")
    }
  }
}
