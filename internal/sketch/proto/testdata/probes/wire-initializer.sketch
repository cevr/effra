// want S102
package demo
type Fault struct{}
func unused() error[Fault] { return Fault{} }
type Store interface { Get() string }
type Box interface { Get() string }
type Holder struct{ Value string }
func (h Holder) Get() string { return h.Value }
func read() string needs Store { return Store.Get() }
func main() needs Console {
  with(wire{ Box = Holder{Value: read()} }) {
    Console.Println(Box.Get())
  }
}
