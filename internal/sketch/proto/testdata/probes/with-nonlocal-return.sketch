// want S109
package demo
type Fault struct{}
func unused() error[Fault] { return Fault{} }
type Store interface { Get() string }
type Mem struct{}
func (Mem) Get() string { return "value" }
func f() string uses Console {
  with(wire{ Store = Mem{} }) {
    Console.Println(Store.Get())
    return "inner"
  }
  return "after"
}
func main() uses Console { Console.Println(f()) }
