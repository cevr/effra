// out: ok
package demo
import "timeout"
type Store interface { Get() string }
type Holder struct{ Value string }
func (h Holder) Get() string { return h.Value }
func build() string {
  return with(wire{ Scheduler = LiveScheduler{} }) {
    timeout.After(1s) { "ok" }
  } catch { case timeout.Expired: "late" }
}
wire W { Store = Holder{Value: build()} }
func main() needs Console { Console.Println(with(W) { Store.Get() }) }
