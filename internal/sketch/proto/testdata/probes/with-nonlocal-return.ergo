// want S109
type Fault {}
func unused() fails Fault { return Fault }
type Store { Get() string }
type Mem {}
func Get(_ Mem) string { return "value" }
func f() string needs Console {
	with wire { Store: Mem } {
		Console.Println("\(Store.Get())")
		return "inner"
	}
	return "after"
}
func main() needs Console { Console.Println("\(f())") }
