// out: ok {a}
type Fault {}
type A { Value string }
type B {}
type Sum = A | B
func a() Sum                   { return A{Value: "a"} }
func fail() string fails Fault { return Fault }
func main() needs Console {
	let x = fail() catch {
	case Fault:
		"ok"
	}
	let y = a()
	Console.Println("\(x) \(y)")
}
