// want S108
package demo
type Fault struct{}
func unused() error[Fault] { return Fault{} }
type A struct{ Value string }
type B struct{}
type Sum interface{ A | B }
type Box struct{ Choice Sum }
func pick(s Sum) string {
  switch v := s.(type) {
  case A: return v.Value
  case B: return "b"
  }
}
func main() needs Console {
  box := Box{}
  Console.Println(pick(box.Choice))
}
