// Witnesses of the node families lower-v1 stage 2 lowers, with their
// independently computed results (families.out). Each line of output names
// the family it witnesses.
import timeout

type Shape = Circle | Square | Dot
type Circle { R int }
type Square { S int }
type Dot {}

type Named { Name() string }

func Name(c Circle) string { return "circle" }

let limit = 3

let greeting = "hi"

func classify(s Shape) string {
	match s {
	case Circle as c:
		if c.R > 1 {
			return "big circle"
		}
		return "small circle"
	case _:
		return "other"
	}
}

func word(n int) string {
	match n {
	case 0:
		return "zero"
	case 1, 2:
		return "few"
	case _:
		return "many"
	}
}

func expire(fail bool) int fails timeout.Expired {
	if fail {
		return timeout.Expired
	}
	return 1
}

func bump(p *Square) {
	p.S = p.S + 1
}

func loops() int {
	let mut i = 0
	let mut sum = 0
	for {
		i += 1
		if i > 10 {
			break
		}
		match i % 3 {
		case 0:
			continue
		case _:
		}
		sum += i
	}
	return sum
}

func widths() bool {
	let a int8 = 100
	let b int16 = 300
	let c int32 = 70000
	let d int64 = 5000000000
	let e uint = 7
	let f uint8 = 200
	let g uint16 = 60000
	let h uint32 = 4000000000
	let k uint64 = 18000000000000000000
	let m float32 = 0.1
	let n float64 = 0.25
	let o bool = true
	let p string = "s"
	let q duration = 2s
	let r rune = 'x'
	let wa int8 = a*2 + 1
	let wf uint8 = f + f
	let fm float32 = m * 3
	return wa == -55 && b*2 == 600 && c+1 == 70001 && d/5 == 1000000000 && e-2 == 5 && wf == 144 && g+1 == 60001 && h > 3000000000 && k > 17000000000000000000 && fm == 0.3 && n*4.0 == 1.0 && o && p+"t" == "st" && q+1s == 3s && r == 'x'
}

func main() needs Console {
	let shapes = []Shape{Circle{R: 2}, Square{S: 1}, Dot}
	Console.Println(classify(shapes[0]) + ", " + classify(shapes[1]) + ", " + classify(Circle{R: 1}))
	Console.Println(word(0) + " " + word(2) + " " + word(limit))
	let half = shapes[1:]
	if len(half) == 2 && len(shapes[:1]) == 1 {
		Console.Println("slices")
	}
	let ages = Map[string, int]{"ada": 36, "bob": 40}
	if len(ages) == 2 {
		Console.Println("maps")
	}
	let n Named = Circle{R: 3}
	Console.Println(n.Name())
	let pick = func(x int) int { return -x }
	if pick(4) == -4 && !(pick(1) > 0) && ^0 == -1 {
		Console.Println("function values and unary operators")
	}
	if int64(7)/2 == 3 && float64(int32(3)) == 3.0 && int('a') == 97 {
		Console.Println("conversions")
	}
	let v = expire(true) catch {
	case timeout.Expired:
		0
	}
	if v == 0 {
		Console.Println("imported error type")
	}
	let mut sq = Square{S: 1}
	bump(&sq)
	if sq.S == 2 {
		Console.Println("borrow")
	}
	if loops() == 37 {
		Console.Println("loops")
	}
	let inner = greeting + "!"
	Console.Println(inner)
	let clock LiveScheduler
	clock.Sleep(1ms)
	if widths() {
		Console.Println("widths")
	}
}
