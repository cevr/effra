// out: slept|timed out
package demo

import "timeout"

func nap() (string, error[timeout.Expired]) needs Scheduler {
	value := try timeout.After(1s) { pause() }
	return value
}

func stall() (string, error[timeout.Expired]) needs Scheduler {
	value := try timeout.After(1ms) { block() }
	return value
}

func pause() string needs Scheduler {
	Scheduler.Sleep(1ms)
	return "slept"
}

func block() string needs Scheduler {
	Scheduler.Sleep(10s)
	return "woke"
}

wire Clock {
	Scheduler = LiveScheduler{}
}

func main() needs Console {
	first := with(Clock) { nap() } catch {
	case timeout.Expired:
		"timed out"
	}
	Console.Println(first)
	second := with(Clock) { stall() } catch {
	case timeout.Expired:
		"timed out"
	}
	Console.Println(second)
}
