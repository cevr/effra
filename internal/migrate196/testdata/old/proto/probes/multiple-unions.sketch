// out: {one} {two}
package demo
type Fault struct{}
func unused() error[Fault] { return Fault{} }
type A struct{ Value string }
type B struct{}
type C struct{}
type Sum interface{ A | B }
type Other interface{ A | C }
func one() Sum { return A{Value: "one"} }
func two() Other { return A{Value: "two"} }
func main() needs Console { Console.Println(one(), two()) }
