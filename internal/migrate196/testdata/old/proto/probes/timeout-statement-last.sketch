// want S109
package demo
import "timeout"
type Fault struct{}
func unused() error[Fault] { return Fault{} }
func main() needs Console {
  with(wire{ Scheduler = LiveScheduler{} }) {
    timeout.After(1s) {
      if "a" == "a" { Console.Println("ok") }
    } catch { case timeout.Expired: Console.Println("late") }
  }
}
