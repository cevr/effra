// Hand migration of examples/lifecycle.ef to the 2026 edition (docs/spec/ v0).
// Host-package and config names (fs.FS, fs.Error, config.Config, the Live
// providers) are provisional: docs/spec/stdlib.md fixes the families, not
// the API.
package main

import (
	"config"
	"fs"
	"timeout"
)

func worker() needs Clock {
	Clock.Sleep(10000ms)
}

func scopedRead() (string, error[fs.Error]) needs fs.FS, Console {
	file := try FS.Open("examples/fixture.txt")
	// Runtime.inspect() has no spec-v0 counterpart: live task state is
	// ef ps (runtime.md, G3), outside the program.
	return FS.ReadText(file)
} // file closed here (resources.md, R5)

func program() error[fs.Error] needs Clock, fs.FS, Console, config.Config, Scheduler {
	child := go worker()
	child.Stop()
	text := try scopedRead()
	Console.Println(text)
	timeout.After(1ms) { worker() } catch {
	case timeout.Expired:
	}
	home := Config.String("EFFRA_DEMO_LABEL")
	Console.Println("label: " + home)
}

wire Live {
	Clock     = LiveClock{}
	FS        = fs.Live{}
	Config    = config.Env{}
	Scheduler = LiveScheduler{}
}

func main() error[fs.Error] needs Console {
	return with(Live) { program() }
}
