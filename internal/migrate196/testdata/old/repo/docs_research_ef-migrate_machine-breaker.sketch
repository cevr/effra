// A circuit breaker whose step is an effect function: it consults a probe
// service before half-opening. The machine plan records the step's failure
// and service rows as the declaration's terminal row and requirements.
// Hand migration of examples/machine-breaker.ef to the 2026 edition
// (docs/spec/ v0, runtime.md "Machines and actors"). The Decision variant
// field names Next and Output are provisional: the spec shows only
// positional literals.
package main

type ProbeUnavailable struct{}

type Probe interface {
	Healthy(endpoint string) (bool, error[ProbeUnavailable])
}

type HealthyProbe struct{}

func (HealthyProbe) Healthy(endpoint string) (bool, error[ProbeUnavailable]) {
	return endpoint == "primary"
}

type Breaker interface{ Closed | Open | HalfOpen }

type Closed struct{ failures int64 }
type Open struct{ endpoint string }
type HalfOpen struct{ endpoint string }

type Signal interface{ Failure | Success | Retry | Retire }

type Failure struct{ endpoint string }
type Success struct{}
type Retry struct{}
type Retire struct{}

func tripped(endpoint string) Breaker {
	return Open{endpoint: endpoint}
}

func breakerStep(state Breaker, signal Signal) (Decision[Breaker, string], error[ProbeUnavailable]) needs Probe {
	switch s, sig := state.(type), signal.(type) {
	case (Closed, Failure):
		if s.failures >= 2 {
			return Enter{tripped(sig.endpoint)}
		}
		return Stay{Closed{s.failures + 1}}
	case (Closed, Success):
		return Stay{Closed{0}}
	case (Closed, Retry), (HalfOpen, Retry):
		return Ignore{}
	case (Open, Retry):
		healthy := try Probe.Healthy(s.endpoint)
		if healthy {
			return Enter{HalfOpen{s.endpoint}}
		}
		return Stay{state}
	case (Open, Failure), (HalfOpen, Failure):
		return Enter{tripped(sig.endpoint)}
	case (HalfOpen, Success):
		return Enter{Closed{0}}
	case (Open, Success):
		return Reject{}
	case (_, Retire):
		return Done{"retired"}
	}
}

type CircuitBreaker machine[Breaker, Signal] {
	initial Closed{failures: 0}
	step    breakerStep
}

func describe(decision Decision[Breaker, string]) string {
	switch d := decision.(type) {
	case Enter:
		return "enter " + label(d.Next)
	case Stay:
		return "stay " + label(d.Next)
	case Ignore:
		return "ignore"
	case Reject:
		return "reject"
	case Done:
		return "done " + d.Output
	}
}

func label(state Breaker) string {
	switch s := state.(type) {
	case Closed:
		return "closed"
	case Open:
		return "open " + s.endpoint
	case HalfOpen:
		return "half-open " + s.endpoint
	}
}

func main() error[ProbeUnavailable] needs Console {
	open := tripped("primary")
	retried := try with(wire{ Probe = HealthyProbe{} }) { breakerStep(open, Retry{}) }
	failed := try with(wire{ Probe = HealthyProbe{} }) { breakerStep(Closed{failures: 2}, Failure{endpoint: "primary"}) }
	retired := try with(wire{ Probe = HealthyProbe{} }) { breakerStep(open, Retire{}) }
	Console.Println(describe(retried) + "; " + describe(failed) + "; " + describe(retired))
}
