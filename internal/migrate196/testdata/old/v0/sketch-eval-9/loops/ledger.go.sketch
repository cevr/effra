package ledger

type Insufficient struct{ ID string }

type Account struct {
	ID      string
	Balance int64
	History []int64
}

type Transfer struct {
	From, To int
	Amount   int64
}

// A *T parameter is a borrow: never nil, never stored, never returned.
func move(from, to *Account, amount int64) error[Insufficient] {
	if from.Balance < amount {
		return Insufficient{from.ID}
	}
	from.Balance -= amount
	to.Balance += amount
	from.History = append(from.History, -amount)
	to.History = append(to.History, amount)
}

// Two borrows into one slice need a proof that they do not overlap.
// Without the From == To guard, the checker rejects the move call.
func apply(accounts *[]Account, transfers []Transfer) int {
	rejected := 0
	for _, t := range transfers {
		if t.From == t.To {
			rejected++
			continue
		}
		move(&accounts[t.From], &accounts[t.To], t.Amount) catch {
		case Insufficient:
			rejected++
		}
	}
	return rejected
}

// ef test checks a Law like a fuzz target; ef prove tries to prove it.
func LawMoveConservesMoney(from, to Account, amount int64) bool {
	total := from.Balance + to.Balance
	move(&from, &to, amount) catch {
	case Insufficient:
	}
	return from.Balance+to.Balance == total
}

func main() needs Console {
	accounts := []Account{{ID: "a", Balance: 100}, {ID: "b", Balance: 50}}
	before := accounts // a value copy: apply cannot change it
	rejected := apply(&accounts, []Transfer{{0, 1, 30}, {1, 0, 500}, {0, 0, 10}})
	Console.Println(before[0].Balance, accounts[0].Balance, rejected) // 100 70 2
}
