error Boom { code: i64 }
error Nope { code: i64 }
effect fn job() -> string raises { Boom } {
    fail Boom { code: 7 }
}
effect fn bail() -> string raises { Nope } {
    fail Nope { code: 1 }
}
effect fn stage() -> string raises { Nope, Boom } uses { Scheduler } {
    let fiber = fork job()
    let early = run bail()
    run fiber.join()
}
effect fn consume() -> string uses { Scheduler } {
    scope {
        let r = run stage().catch<Nope>("recovered-early").catch<Boom>("joined")
        run Scheduler.sleep(200)
        r
    }
}
effect fn main() -> void {
    run Console.log(run consume().provide<Scheduler>(LiveScheduler)).provide<Console>(Stdout)
}
