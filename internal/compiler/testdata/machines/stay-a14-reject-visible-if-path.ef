enum SessionState { Idle  Active { key: string }  Closed }
enum SessionEvent { Open { key: string }  Close  Touch  Restore { snapshot: SessionState } }
fn sessionStep(state: SessionState, event: SessionEvent) -> decision<SessionState, void> {
    match state, event {
        SessionState.Active { key }, SessionEvent.Open { key: next } => stay (if key == next { state } else { SessionState.Idle {} })
        SessionState.Active, SessionEvent.Close | SessionEvent.Touch | SessionEvent.Restore => ignore
        SessionState.Idle | SessionState.Closed, SessionEvent.Open | SessionEvent.Close | SessionEvent.Touch | SessionEvent.Restore => ignore
    }
}

machine Session {
    initial SessionState.Idle {}
    step sessionStep
}
