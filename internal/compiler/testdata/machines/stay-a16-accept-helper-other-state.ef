enum SessionState { Idle  Active { key: string }  Closed }
enum SessionEvent { Open { key: string }  Close  Touch  Restore { snapshot: SessionState } }
fn retarget(target: SessionState) -> decision<SessionState, void> {
    match target {
        SessionState.Idle => stay SessionState.Active { key: "k" }
        SessionState.Active | SessionState.Closed => ignore
    }
}
fn sessionStep(state: SessionState, event: SessionEvent) -> decision<SessionState, void> {
    match state, event {
        SessionState.Active, SessionEvent.Touch => retarget(SessionState.Idle {})
        SessionState.Active, SessionEvent.Open | SessionEvent.Close | SessionEvent.Restore => ignore
        SessionState.Idle | SessionState.Closed, SessionEvent.Open | SessionEvent.Close | SessionEvent.Touch | SessionEvent.Restore => ignore
    }
}

machine Session {
    initial SessionState.Idle {}
    step sessionStep
}
