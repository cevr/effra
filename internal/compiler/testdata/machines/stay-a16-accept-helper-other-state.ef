import Machines "effra/machines"

enum SessionState { Idle  Active { key: string }  Closed }
enum SessionEvent { Open { key: string }  Close  Touch  Restore { snapshot: SessionState } }
fn retarget(target: SessionState) -> Machines.Step<SessionState, void> {
    match target {
        SessionState.Idle => Machines.Step<SessionState, void>.Stay { next: SessionState.Active { key: "k" } }
        SessionState.Active | SessionState.Closed => Machines.Step<SessionState, void>.Ignore {}
    }
}
fn sessionStep(state: SessionState, event: SessionEvent) -> Machines.Step<SessionState, void> {
    match state, event {
        SessionState.Active, SessionEvent.Touch => retarget(SessionState.Idle {})
        SessionState.Active, SessionEvent.Open | SessionEvent.Close | SessionEvent.Restore => Machines.Step<SessionState, void>.Ignore {}
        SessionState.Idle | SessionState.Closed, SessionEvent.Open | SessionEvent.Close | SessionEvent.Touch | SessionEvent.Restore => Machines.Step<SessionState, void>.Ignore {}
    }
}

machine Session {
    initial SessionState.Idle {}
    step sessionStep
}
