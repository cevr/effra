enum SessionState { Idle  Active { key: string }  Closed }
enum SessionEvent { Open { key: string }  Close  Touch  Restore { state: SessionState } }
fn sessionStep(state: SessionState, event: SessionEvent) -> decision<SessionState, void> {
    match state, event {
        SessionState.Idle, SessionEvent.Restore { state } => stay state
        SessionState.Idle, SessionEvent.Open { key } => stay SessionState.Idle {}
        SessionState.Active | SessionState.Closed, SessionEvent.Open | SessionEvent.Close | SessionEvent.Touch | SessionEvent.Restore => ignore
        SessionState.Idle, SessionEvent.Close | SessionEvent.Touch => ignore
    }
}

machine Session {
    initial SessionState.Idle {}
    step sessionStep
}
