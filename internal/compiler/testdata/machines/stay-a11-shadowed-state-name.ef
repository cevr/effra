import Machines "effra/machines"

enum SessionState { Idle  Active { key: string }  Closed }
enum SessionEvent { Open { key: string }  Close  Touch  Restore { state: SessionState } }
fn sessionStep(state: SessionState, event: SessionEvent) -> Machines.Step<SessionState, void> {
    match state, event {
        SessionState.Idle, SessionEvent.Restore { state } => Machines.Step<SessionState, void>.Stay { next: state }
        SessionState.Idle, SessionEvent.Open { key } => Machines.Step<SessionState, void>.Stay { next: SessionState.Idle {} }
        SessionState.Active | SessionState.Closed, SessionEvent.Open | SessionEvent.Close | SessionEvent.Touch | SessionEvent.Restore => Machines.Step<SessionState, void>.Ignore {}
        SessionState.Idle, SessionEvent.Close | SessionEvent.Touch => Machines.Step<SessionState, void>.Ignore {}
    }
}

machine Session {
    initial SessionState.Idle {}
    step sessionStep
}
