enum SessionState { Idle  Active { key: string }  Closed }
enum SessionEvent { Open { key: string }  Close  Touch  Restore { snapshot: SessionState } }
fn sessionStep(state: SessionState, event: SessionEvent) -> decision<SessionState, void> {
    match state, event {
        SessionState.Idle | SessionState.Active { key: _ }, SessionEvent.Open { key } => stay SessionState.Active { key: key }
        SessionState.Idle | SessionState.Active { key: _ }, SessionEvent.Touch => stay state
        SessionState.Idle | SessionState.Active, SessionEvent.Close | SessionEvent.Restore => ignore
        SessionState.Closed, SessionEvent.Open | SessionEvent.Close | SessionEvent.Touch | SessionEvent.Restore => stay SessionState.Closed {}
    }
}

machine Session {
    initial SessionState.Idle {}
    step sessionStep
}
