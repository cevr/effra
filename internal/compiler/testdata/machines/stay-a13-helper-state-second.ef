enum SessionState { Idle  Active { key: string }  Closed }
enum SessionEvent { Open { key: string }  Close  Touch  Restore { snapshot: SessionState } }
fn merge(incoming: SessionState, current: SessionState) -> decision<SessionState, void> {
    match current, incoming {
        SessionState.Idle, SessionState.Active => stay SessionState.Active { key: "k" }
        SessionState.Idle, SessionState.Idle | SessionState.Closed => ignore
        SessionState.Active | SessionState.Closed, SessionState.Idle | SessionState.Active | SessionState.Closed => ignore
    }
}
fn sessionStep(state: SessionState, event: SessionEvent) -> decision<SessionState, void> {
    match event {
        SessionEvent.Restore { snapshot } => merge(snapshot, state)
        SessionEvent.Open | SessionEvent.Close | SessionEvent.Touch => ignore
    }
}

machine Session {
    initial SessionState.Idle {}
    step sessionStep
}
