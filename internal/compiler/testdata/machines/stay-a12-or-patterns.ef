import Machines "effra/machines"

enum SessionState { Idle  Active { key: string }  Closed }
enum SessionEvent { Open { key: string }  Close  Touch  Restore { snapshot: SessionState } }
fn sessionStep(state: SessionState, event: SessionEvent) -> Machines.Step<SessionState, void> {
    match state, event {
        SessionState.Idle | SessionState.Closed, SessionEvent.Open { key } => Machines.Step<SessionState, void>.Stay { next: SessionState.Active { key: key } }
        SessionState.Idle | SessionState.Closed, SessionEvent.Touch => Machines.Step<SessionState, void>.Stay { next: SessionState.Idle {} }
        SessionState.Idle | SessionState.Closed, SessionEvent.Close => match state { SessionState.Idle => Machines.Step<SessionState, void>.Stay { next: SessionState.Idle {} } SessionState.Closed => Machines.Step<SessionState, void>.Stay { next: SessionState.Closed {} } SessionState.Active => Machines.Step<SessionState, void>.Stay { next: SessionState.Idle {} } }
        SessionState.Idle | SessionState.Closed, SessionEvent.Restore => Machines.Step<SessionState, void>.Ignore {}
        SessionState.Active, SessionEvent.Open | SessionEvent.Close | SessionEvent.Touch | SessionEvent.Restore => Machines.Step<SessionState, void>.Ignore {}
    }
}

machine Session {
    initial SessionState.Idle {}
    step sessionStep
}
