import Machines "effra/machines"

enum SessionState { Idle  Active { key: string }  Closed }
enum SessionEvent { Open { key: string }  Close  Touch  Restore { snapshot: SessionState } }
fn activate(key: string) -> SessionState {
    SessionState.Active { key: key }
}
fn sessionStep(state: SessionState, event: SessionEvent) -> Machines.Step<SessionState, void> {
    match state, event {
        SessionState.Idle, SessionEvent.Open { key } => Machines.Step<SessionState, void>.Stay { next: activate(key) }
        SessionState.Active | SessionState.Closed, SessionEvent.Open | SessionEvent.Close | SessionEvent.Touch | SessionEvent.Restore => Machines.Step<SessionState, void>.Ignore {}
        SessionState.Idle, SessionEvent.Close | SessionEvent.Touch | SessionEvent.Restore => Machines.Step<SessionState, void>.Ignore {}
    }
}

machine Session {
    initial SessionState.Idle {}
    step sessionStep
}
