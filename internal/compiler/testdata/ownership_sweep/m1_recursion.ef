error Boom { code: i64 }
effect fn job() -> string raises { Boom } {
    fail Boom { code: 7 }
}
effect fn rec(n: i64) -> string raises { Boom } uses { Scheduler } {
    let g = fork job()
    run Scheduler.sleep(30)
    let inner = if n == 2 { "base" } else { run rec(2) }
    run g.join().catch<Boom>(inner)
}
effect fn consume() -> string uses { Scheduler } {
    scope { run rec(0).catch<Boom>("b") }
}
effect fn main() -> void {
    run Console.log(run consume().provide<Scheduler>(LiveScheduler)).provide<Console>(Stdout)
}
