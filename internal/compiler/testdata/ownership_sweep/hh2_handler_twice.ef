error Boom { code: i64 }
error Nope { code: i64 }
effect fn job() -> string raises { Boom } {
    fail Boom { code: 7 }
}
effect fn job2() -> string raises { Nope } {
    fail Nope { code: 1 }
}
effect fn quiet() -> string uses { Scheduler } {
    run Scheduler.sleep(10)
    "q"
}
effect fn failNope() -> string raises { Nope } {
    fail Nope { code: 1 }
}
effect fn h(n: Nope) -> string raises { Boom } uses { Scheduler } {
    let g = fork job()
    run Scheduler.sleep(30)
    "h"
}
effect fn stage() -> string raises { Boom } uses { Scheduler } {
    let a = run failNope().recover<Nope>(h)
    let b = run failNope().recover<Nope>(h)
    b
}
effect fn consume() -> string raises { Boom } uses { Scheduler } {
    scope { run stage() }
}
effect fn main() -> void {
    run Console.log(run consume().catch<Boom>("b").provide<Scheduler>(LiveScheduler)).provide<Console>(Stdout)
}
