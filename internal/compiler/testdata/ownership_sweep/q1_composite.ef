error Boom { code: i64 }
error Nope { code: i64 }
effect fn job() -> string raises { Boom } {
    fail Boom { code: 7 }
}
effect fn stage() -> string raises { Nope, Boom } uses { Scheduler } {
    let g = fork job()
    run Scheduler.sleep(30)
    fail Nope { code: 1 }
}
effect fn consume() -> string raises { Nope, Boom } uses { Scheduler } {
    let r = scope { run stage() }
    r
}
effect fn main() -> void raises { Boom } {
    let r = run consume().catch<Nope>("n").provide<Scheduler>(LiveScheduler)
    run Console.log(r).provide<Console>(Stdout)
}
