error Boom { code: i64 }
effect fn job() -> string raises { Boom } {
    fail Boom { code: 7 }
}
effect fn stage() -> string raises { Boom } uses { Scheduler } {
    let g = fork job()
    run Scheduler.sleep(30)
    "x"
}
record Box { task: Effect<string, { Boom }, { Scheduler }> }
effect fn consume() -> string uses { Scheduler } {
    scope {
        let b = Box { task: stage() }
        run b.task.catch<Boom>("b")
    }
}
effect fn main() -> void {
    run Console.log(run consume().provide<Scheduler>(LiveScheduler)).provide<Console>(Stdout)
}
