error Boom { code: i64 }
error Nope { code: i64 }
effect fn job() -> string raises { Boom } {
    fail Boom { code: 7 }
}
effect fn job2() -> string raises { Nope } {
    fail Nope { code: 1 }
}
effect fn quiet() -> string uses { Scheduler } {
    run Scheduler.sleep(10)
    "q"
}
effect fn spawn() -> string raises { Boom } uses { Scheduler } {
    let g = fork job()
    run Scheduler.sleep(1)
    "spawned"
}

effect fn stage() -> string raises { Boom, Nope } uses { Scheduler } {
    let a = fork job()
    let b = fork job2()
    run Scheduler.sleep(50)
    "done"
}
effect fn main() -> void raises { Boom, Nope } {
    let r = run stage().provide<Scheduler>(LiveScheduler)
    run Console.log(r).provide<Console>(Stdout)
}
