error Boom { code: i64 }
error Nope { code: i64 }
effect fn job() -> string raises { Boom } {
    fail Boom { code: 7 }
}
effect fn job2() -> string raises { Nope } {
    fail Nope { code: 1 }
}
effect fn consume() -> string raises { Boom } uses { Scheduler } {
    scope {
        let a = fork job()
        let b = fork job()
        run Scheduler.sleep(50)
        "done"
    }
}
effect fn main() -> void {
    let r = run consume().catch<Boom>("b").provide<Scheduler>(LiveScheduler)
    run Console.log(r).provide<Console>(Stdout)
}
