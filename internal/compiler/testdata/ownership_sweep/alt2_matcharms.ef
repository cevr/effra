error Boom { code: i64 }
error Nope { code: i64 }
effect fn job() -> string raises { Boom } {
    fail Boom { code: 7 }
}
effect fn job2() -> string raises { Nope } {
    fail Nope { code: 1 }
}
effect fn quiet() -> string uses { Scheduler } {
    run Scheduler.sleep(10)
    "q"
}
effect fn spawn() -> string raises { Boom } uses { Scheduler } {
    let g = fork job()
    run Scheduler.sleep(1)
    "spawned"
}

enum Pick { A, B }
effect fn consume(p: Pick) -> string raises { Boom } uses { Scheduler } {
    scope {
        match p {
            Pick.A => { let a = fork job() "x" }
            Pick.B => { let b = fork job() "y" }
        }
        run Scheduler.sleep(50)
        "done"
    }
}
effect fn main() -> void {
    let r = run consume(Pick.A {}).catch<Boom>("b").provide<Scheduler>(LiveScheduler)
    run Console.log(r).provide<Console>(Stdout)
}
