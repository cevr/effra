    {"id": "i64.min", "plan": "integer", "direction": "decode", "body": "\"-9223372036854775808\"", "expect": {"ok": true, "encoded": "\"-9223372036854775808\""}, "comparison": "matched"},
    {"id": "i64.above-max", "plan": "integer", "direction": "decode", "body": "\"9223372036854775808\"", "expect": {"ok": false, "reason": "range", "path": [], "offset": -1}, "comparison": "matched"},
    {"id": "i64.below-min", "plan": "integer", "direction": "decode", "body": "\"-9223372036854775809\"", "expect": {"ok": false, "reason": "range", "path": [], "offset": -1}, "comparison": "matched"},
    {"id": "i64.huge", "plan": "integer", "direction": "decode", "body": "\"1000000000000000000000000000000\"", "expect": {"ok": false, "reason": "range", "path": [], "offset": -1}, "comparison": "matched"},
