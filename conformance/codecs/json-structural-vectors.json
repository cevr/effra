    {"id": "failure.conflict", "plan": "failures", "direction": "decode", "body": "{\"reason\":\"taken\",\"_tag\":\"Conflict\"}", "expect": {"ok": true, "encoded": "{\"_tag\":\"Conflict\",\"reason\":\"taken\"}"}, "comparison": "matched"},
    {"id": "failure.undeclared", "plan": "failures", "direction": "decode", "body": "{\"_tag\":\"Timeout\"}", "expect": {"ok": false, "reason": "tag", "path": [], "offset": -1}, "comparison": "matched"},
    {"id": "failure.payload-type", "plan": "failures", "direction": "decode", "body": "{\"_tag\":\"NotFound\",\"id\":7,\"resource\":\"user\"}", "expect": {"ok": false, "reason": "type", "path": ["id"], "offset": -1}, "comparison": "matched"},
    {"id": "i64.plain", "plan": "integer", "direction": "decode", "body": "\"42\"", "expect": {"ok": true, "encoded": "\"42\""}, "comparison": "matched"},
    {"id": "i64.leading-zeros", "plan": "integer", "direction": "decode", "body": "\"0042\"", "expect": {"ok": true, "encoded": "\"42\""}, "comparison": "matched"},
