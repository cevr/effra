    {"id": "union.non-string-tag", "plan": "state", "direction": "decode", "body": "{\"_tag\":1}", "expect": {"ok": false, "reason": "tag", "path": [], "offset": -1}, "comparison": "matched"},
    {"id": "union.tag-case", "plan": "state", "direction": "decode", "body": "{\"_tag\":\"idle\"}", "expect": {"ok": false, "reason": "tag", "path": [], "offset": -1}, "comparison": "matched"},
    {"id": "union.domain-tag", "plan": "state", "direction": "decode", "body": "{\"_tag\":\"State.Idle\"}", "expect": {"ok": false, "reason": "tag", "path": [], "offset": -1}, "comparison": "matched"},
    {"id": "union.variant-field-missing", "plan": "state", "direction": "decode", "body": "{\"_tag\":\"Running\",\"runId\":\"r\"}", "expect": {"ok": false, "reason": "missing", "path": ["owner"], "offset": -1}, "comparison": "matched"},
    {"id": "union.nested-path", "plan": "account", "direction": "decode", "body": "{\"id\":\"1\",\"owner\":{\"name\":\"Ada\",\"email\":\"ada@example.test\"},\"state\":{\"_tag\":\"Running\",\"runId\":\"r\",\"owner\":{\"name\":\"n\",\"email\":1}},\"active\":true,\"note\":null}", "expect": {"ok": false, "reason": "type", "path": ["state", "owner", "email"], "offset": -1}, "comparison": "matched"},
    {"id": "union.string", "plan": "state", "direction": "decode", "body": "\"Idle\"", "expect": {"ok": false, "reason": "type", "path": [], "offset": -1}, "comparison": "matched"},
    {"id": "union.null", "plan": "state", "direction": "decode", "body": "null", "expect": {"ok": false, "reason": "type", "path": [], "offset": -1}, "comparison": "matched"},
