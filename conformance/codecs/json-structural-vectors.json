    {"id": "string.number", "plan": "text", "direction": "decode", "body": "1", "expect": {"ok": false, "reason": "type", "path": [], "offset": -1}, "comparison": "matched"},
    {"id": "string.object", "plan": "text", "direction": "decode", "body": "{}", "expect": {"ok": false, "reason": "type", "path": [], "offset": -1}, "comparison": "matched"},
    {"id": "utf8.invalid-byte", "plan": "text", "direction": "decode", "bodyHex": "2261ff6222", "expect": {"ok": false, "reason": "invalid-unicode", "path": [], "offset": 2}, "comparison": "difference", "note": "TextDecoder replaces the ill-formed byte with U+FFFD and Schema accepts; Effra rejects ill-formed UTF-8."},
    {"id": "utf8.overlong", "plan": "text", "direction": "decode", "bodyHex": "22c0af22", "expect": {"ok": false, "reason": "invalid-unicode", "path": [], "offset": 1}, "comparison": "difference", "note": "An overlong encoding is replaced by TextDecoder and accepted by the comparator."},
    {"id": "utf8.encoded-surrogate", "plan": "text", "direction": "decode", "bodyHex": "22eda08022", "expect": {"ok": false, "reason": "invalid-unicode", "path": [], "offset": 1}, "comparison": "difference", "note": "A UTF-8 encoded surrogate is replaced by TextDecoder and accepted by the comparator."},
    {"id": "utf8.truncated", "plan": "text", "direction": "decode", "bodyHex": "22e28222", "expect": {"ok": false, "reason": "invalid-unicode", "path": [], "offset": 1}, "comparison": "difference", "note": "A truncated sequence is replaced by TextDecoder and accepted by the comparator."},
    {"id": "utf8.above-unicode", "plan": "text", "direction": "decode", "bodyHex": "22f490808022", "expect": {"ok": false, "reason": "invalid-unicode", "path": [], "offset": 1}, "comparison": "difference", "note": "A sequence above U+10FFFF is replaced by TextDecoder and accepted by the comparator."},
    {"id": "utf8.replacement-character", "plan": "text", "direction": "decode", "bodyHex": "22efbfbd22", "expect": {"ok": true, "encoded": "\"\ufffd\""}, "comparison": "matched"},
    {"id": "utf8.outside-string", "plan": "text", "direction": "decode", "bodyHex": "c3a9", "expect": {"ok": false, "reason": "syntax", "path": [], "offset": 0}, "comparison": "matched"},
    {"id": "utf8.byte-order-mark", "plan": "text", "direction": "decode", "bodyHex": "efbbbf226122", "expect": {"ok": false, "reason": "syntax", "path": [], "offset": 0}, "comparison": "difference", "note": "WHATWG TextDecoder strips a leading byte-order mark before JSON.parse; Effra rejects it as non-JSON text."},
    {"id": "syntax.empty", "plan": "text", "direction": "decode", "body": "", "expect": {"ok": false, "reason": "syntax", "path": [], "offset": 0}, "comparison": "matched"},
    {"id": "syntax.whitespace-only", "plan": "text", "direction": "decode", "body": "  ", "expect": {"ok": false, "reason": "syntax", "path": [], "offset": 2}, "comparison": "matched"},
    {"id": "syntax.whitespace-accepted", "plan": "text", "direction": "decode", "body": " \t\n\r\"a\"\r\n", "expect": {"ok": true, "encoded": "\"a\""}, "comparison": "matched"},
    {"id": "syntax.trailing-data", "plan": "text", "direction": "decode", "body": "\"a\" x", "expect": {"ok": false, "reason": "syntax", "path": [], "offset": 4}, "comparison": "matched"},
    {"id": "syntax.trailing-comma", "plan": "account", "direction": "decode", "body": "{\"id\":\"1\",}", "expect": {"ok": false, "reason": "syntax", "path": [], "offset": 10}, "comparison": "matched"},
    {"id": "syntax.leading-zero-number", "plan": "account", "direction": "decode", "body": "{\"x\":01}", "expect": {"ok": false, "reason": "syntax", "path": [], "offset": 6}, "comparison": "matched"},
