    {"id": "duplicate.excess-key", "plan": "state", "direction": "decode", "body": "{\"_tag\":\"Idle\",\"x\":1,\"x\":2}", "expect": {"ok": false, "reason": "duplicate-key", "path": [], "offset": 21}, "comparison": "difference", "note": "JSON.parse keeps the last duplicate of an ignored key; Effra rejects every duplicate key."},
    {"id": "duplicate.escaped-spelling", "plan": "state", "direction": "decode", "body": "{\"_tag\":\"Idle\",\"\\u005ftag\":\"Idle\"}", "expect": {"ok": false, "reason": "duplicate-key", "path": [], "offset": 15}, "comparison": "difference", "note": "Keys compare after unescaping; JSON.parse keeps the last value."},
    {"id": "duplicate.nested", "plan": "state", "direction": "decode", "body": "{\"_tag\":\"Idle\",\"x\":{\"a\":1,\"a\":1}}", "expect": {"ok": false, "reason": "duplicate-key", "path": [], "offset": 26}, "comparison": "difference", "note": "Duplicate detection applies inside ignored values; JSON.parse accepts them."},
    {"id": "duplicate.indexed-object", "plan": "state", "direction": "decode", "body": "{\"_tag\":\"Idle\",\"k1\":1,\"k2\":2,\"k3\":3,\"k4\":4,\"k5\":5,\"k6\":6,\"k7\":7,\"k8\":8,\"k9\":9,\"k10\":10,\"k11\":11,\"k12\":12,\"k1\":0}", "expect": {"ok": false, "reason": "duplicate-key", "path": [], "offset": 105}, "comparison": "difference", "note": "Objects beyond the linear-scan threshold still reject duplicates; JSON.parse accepts them."},
    {"id": "depth.within-bound", "plan": "nested", "direction": "decode", "body": "{\"inner\":{\"value\":\"v\"},\"x\":[[1]]}", "expect": {"ok": true, "encoded": "{\"inner\":{\"value\":\"v\"}}"}, "comparison": "matched"},
