{
  "schemaVersion": 1,
  "profile": "effra/json-structural-1",
  "comparator": {"script": "conformance/codecs/effect-comparator.mjs", "output": "conformance/codecs/effect-comparator.out.jsonl", "parseFailure": "Expected a valid JSON string"},
  "plans": {
    "account": {"bounds": {"maxBodyBytes": 1024, "maxDepth": 4}, "root": 4, "nodes": [
      {"kind": "string"},
      {"kind": "bool"},
      {"kind": "i64"},
      {"kind": "void"},
      {"kind": "record", "type": "Account", "fields": [{"name": "id", "node": 2}, {"name": "owner", "node": 5}, {"name": "state", "node": 6}, {"name": "active", "node": 1}, {"name": "note", "node": 3}]},
      {"kind": "record", "type": "Person", "fields": [{"name": "name", "node": 0}, {"name": "email", "node": 0}]},
      {"kind": "union", "type": "State", "variants": [{"tag": "Idle", "domainTag": "State.Idle", "fields": []}, {"tag": "Running", "domainTag": "State.Running", "fields": [{"name": "runId", "node": 0}, {"name": "owner", "node": 5}]}]}
    ]},
    "state": {"bounds": {"maxBodyBytes": 512, "maxDepth": 2}, "root": 1, "nodes": [
      {"kind": "string"},
      {"kind": "union", "type": "State", "variants": [{"tag": "Idle", "domainTag": "State.Idle", "fields": []}, {"tag": "Running", "domainTag": "State.Running", "fields": [{"name": "runId", "node": 0}, {"name": "owner", "node": 2}]}]},
      {"kind": "record", "type": "Person", "fields": [{"name": "name", "node": 0}, {"name": "email", "node": 0}]}
    ]},
    "failures": {"bounds": {"maxBodyBytes": 256, "maxDepth": 1}, "root": 2, "nodes": [
      {"kind": "i64"},
      {"kind": "string"},
      {"kind": "union", "type": "raises{Conflict,NotFound}", "variants": [{"tag": "NotFound", "domainTag": "NotFound", "fields": [{"name": "id", "node": 0}, {"name": "resource", "node": 1}]}, {"tag": "Conflict", "domainTag": "Conflict", "fields": [{"name": "reason", "node": 1}]}]}
    ]},
    "text": {"bounds": {"maxBodyBytes": 256, "maxDepth": 1}, "root": 0, "nodes": [
      {"kind": "string"}
    ]},
    "integer": {"bounds": {"maxBodyBytes": 256, "maxDepth": 1}, "root": 0, "nodes": [
      {"kind": "i64"}
    ]},
    "nothing": {"bounds": {"maxBodyBytes": 64, "maxDepth": 1}, "root": 0, "nodes": [
      {"kind": "void"}
    ]},
    "flag": {"bounds": {"maxBodyBytes": 64, "maxDepth": 1}, "root": 0, "nodes": [
      {"kind": "bool"}
    ]},
    "nested": {"bounds": {"maxBodyBytes": 512, "maxDepth": 3}, "root": 1, "nodes": [
      {"kind": "string"},
      {"kind": "record", "type": "Outer", "fields": [{"name": "inner", "node": 2}]},
      {"kind": "record", "type": "Inner", "fields": [{"name": "value", "node": 0}]}
    ]},
    "label": {"bounds": {"maxBodyBytes": 32, "maxDepth": 1}, "root": 1, "nodes": [
      {"kind": "string"},
      {"kind": "record", "type": "Label", "fields": [{"name": "name", "node": 0}]}
    ]}
  },
  "vectors": [
    {"id": "string.plain", "plan": "text", "direction": "decode", "body": "\"hello\"", "expect": {"ok": true, "encoded": "\"hello\""}, "comparison": "matched"},
    {"id": "string.escapes", "plan": "text", "direction": "decode", "body": "\"\\\"\\\\\\/\\b\\f\\n\\r\\tA\u00e9\u00e9\"", "expect": {"ok": true, "encoded": "\"\\\"\\\\/\\b\\f\\n\\r\\tA\u00e9\u00e9\""}, "comparison": "matched"},
    {"id": "string.surrogate-pair", "plan": "text", "direction": "decode", "body": "\"\ud83d\ude00\"", "expect": {"ok": true, "encoded": "\"\ud83d\ude00\""}, "comparison": "matched"},
    {"id": "string.raw-unicode", "plan": "text", "direction": "decode", "body": "\"<>&\u00e9\ud83d\ude00\u2028\u2029\"", "expect": {"ok": true, "encoded": "\"<>&\u00e9\ud83d\ude00\u2028\u2029\""}, "comparison": "matched"},
    {"id": "string.controls", "plan": "text", "direction": "decode", "body": "\"\\u0001\\u001f\\u007f\"", "expect": {"ok": true, "encoded": "\"\\u0001\\u001f\u007f\""}, "comparison": "matched"},
    {"id": "string.nul", "plan": "text", "direction": "decode", "body": "\"a\\u0000b\"", "expect": {"ok": true, "encoded": "\"a\\u0000b\""}, "comparison": "matched"},
    {"id": "string.lone-high-escape", "plan": "text", "direction": "decode", "body": "\"a\\ud800b\"", "expect": {"ok": false, "reason": "invalid-unicode", "path": [], "offset": 2}, "comparison": "difference", "note": "Effra admits only Unicode scalar values; JSON.parse keeps a lone surrogate code unit."},
    {"id": "string.lone-low-escape", "plan": "text", "direction": "decode", "body": "\"\\udc00\"", "expect": {"ok": false, "reason": "invalid-unicode", "path": [], "offset": 1}, "comparison": "difference", "note": "Effra rejects an unpaired low surrogate escape; JSON.parse keeps it."},
    {"id": "string.high-then-non-low", "plan": "text", "direction": "decode", "body": "\"\\ud800A\"", "expect": {"ok": false, "reason": "invalid-unicode", "path": [], "offset": 1}, "comparison": "difference", "note": "A high surrogate escape followed by a non-surrogate is unpaired; JSON.parse keeps both code units."},
    {"id": "string.raw-control", "plan": "text", "direction": "decode", "body": "\"a\tb\"", "expect": {"ok": false, "reason": "syntax", "path": [], "offset": 2}, "comparison": "matched"},
    {"id": "string.invalid-escape", "plan": "text", "direction": "decode", "body": "\"\\x\"", "expect": {"ok": false, "reason": "syntax", "path": [], "offset": 1}, "comparison": "matched"},
    {"id": "string.short-unicode-escape", "plan": "text", "direction": "decode", "body": "\"\\u12\"", "expect": {"ok": false, "reason": "syntax", "path": [], "offset": 1}, "comparison": "matched"},
    {"id": "string.unterminated", "plan": "text", "direction": "decode", "body": "\"abc", "expect": {"ok": false, "reason": "syntax", "path": [], "offset": 4}, "comparison": "matched"},
