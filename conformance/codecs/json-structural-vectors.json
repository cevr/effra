    {"id": "required.missing-field", "plan": "account", "direction": "decode", "body": "{\"owner\":{\"name\":\"Ada\",\"email\":\"ada@example.test\"},\"state\":{\"_tag\":\"Idle\"},\"active\":true,\"note\":null}", "expect": {"ok": false, "reason": "missing", "path": ["id"], "offset": -1}, "comparison": "matched"},
    {"id": "required.declared-order", "plan": "account", "direction": "decode", "body": "{\"note\":1,\"active\":\"no\",\"id\":\"1\",\"owner\":{\"name\":\"Ada\",\"email\":\"ada@example.test\"},\"state\":{\"_tag\":\"Idle\"}}", "expect": {"ok": false, "reason": "type", "path": ["active"], "offset": -1}, "comparison": "matched"},
    {"id": "required.nested-missing", "plan": "account", "direction": "decode", "body": "{\"id\":\"1\",\"owner\":{\"name\":\"Ada\"},\"state\":{\"_tag\":\"Idle\"},\"active\":true,\"note\":null}", "expect": {"ok": false, "reason": "missing", "path": ["owner", "email"], "offset": -1}, "comparison": "matched"},
    {"id": "null.required-string", "plan": "account", "direction": "decode", "body": "{\"id\":\"1\",\"owner\":{\"name\":null,\"email\":\"e\"},\"state\":{\"_tag\":\"Idle\"},\"active\":true,\"note\":null}", "expect": {"ok": false, "reason": "type", "path": ["owner", "name"], "offset": -1}, "comparison": "matched"},
    {"id": "null.required-record", "plan": "account", "direction": "decode", "body": "{\"id\":\"1\",\"owner\":null,\"state\":{\"_tag\":\"Idle\"},\"active\":true,\"note\":null}", "expect": {"ok": false, "reason": "type", "path": ["owner"], "offset": -1}, "comparison": "matched"},
    {"id": "excess.ignored", "plan": "account", "direction": "decode", "body": "{\"id\":\"1\",\"owner\":{\"name\":\"Ada\",\"email\":\"ada@example.test\"},\"state\":{\"_tag\":\"Idle\"},\"active\":true,\"note\":null,\"extra\":{\"deep\":[1,2,{\"x\":null}]},\"zz\":\"z\"}", "expect": {"ok": true, "encoded": "{\"id\":\"1\",\"owner\":{\"name\":\"Ada\",\"email\":\"ada@example.test\"},\"state\":{\"_tag\":\"Idle\"},\"active\":true,\"note\":null}"}, "comparison": "matched"},
    {"id": "excess.ignored-in-variant", "plan": "account", "direction": "decode", "body": "{\"id\":\"1\",\"owner\":{\"name\":\"Ada\",\"email\":\"ada@example.test\"},\"state\":{\"_tag\":\"Idle\",\"runId\":\"ignored\"},\"active\":true,\"note\":null}", "expect": {"ok": true, "encoded": "{\"id\":\"1\",\"owner\":{\"name\":\"Ada\",\"email\":\"ada@example.test\"},\"state\":{\"_tag\":\"Idle\"},\"active\":true,\"note\":null}"}, "comparison": "matched"},
    {"id": "excess.reordered-input", "plan": "account", "direction": "decode", "body": "{\"note\":null,\"active\":true,\"state\":{\"_tag\":\"Idle\"},\"owner\":{\"email\":\"ada@example.test\",\"name\":\"Ada\"},\"id\":\"1\"}", "expect": {"ok": true, "encoded": "{\"id\":\"1\",\"owner\":{\"name\":\"Ada\",\"email\":\"ada@example.test\"},\"state\":{\"_tag\":\"Idle\"},\"active\":true,\"note\":null}"}, "comparison": "matched"},
    {"id": "void.null", "plan": "nothing", "direction": "decode", "body": "null", "expect": {"ok": true, "encoded": "null"}, "comparison": "matched"},
    {"id": "void.zero", "plan": "nothing", "direction": "decode", "body": "0", "expect": {"ok": false, "reason": "type", "path": [], "offset": -1}, "comparison": "matched"},
