    {"id": "union.payload", "plan": "state", "direction": "decode", "body": "{\"owner\":{\"email\":\"e\",\"name\":\"n\"},\"runId\":\"r\",\"_tag\":\"Running\"}", "expect": {"ok": true, "encoded": "{\"_tag\":\"Running\",\"runId\":\"r\",\"owner\":{\"name\":\"n\",\"email\":\"e\"}}"}, "comparison": "matched"},
    {"id": "union.unknown-tag", "plan": "state", "direction": "decode", "body": "{\"_tag\":\"Paused\"}", "expect": {"ok": false, "reason": "tag", "path": [], "offset": -1}, "comparison": "matched"},
