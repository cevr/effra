    {"id": "void.missing-field", "plan": "account", "direction": "decode", "body": "{\"id\":\"1\",\"owner\":{\"name\":\"Ada\",\"email\":\"ada@example.test\"},\"state\":{\"_tag\":\"Idle\"},\"active\":true}", "expect": {"ok": false, "reason": "missing", "path": ["note"], "offset": -1}, "comparison": "matched"},
