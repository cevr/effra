{
  "extends": "./tsconfig.yield.json",
  "compilerOptions": {
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "rootDir": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": [
      "bun-types"
    ],
    "paths": {}
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "exclude": [
    "tests/types/counter-number-negative.ts",
    "tests/types/counter-state-negative.ts",
    "tests/types/counter-event-negative.ts"
  ]
}
