// expect: accepted (a) keyed by a record wrapping a File, with explicit functions
fn keyedBy<K: type>(key: K, hash: fn(K) -> i64, equals: fn(K, K) -> bool) -> i64 {
    if equals(key, key) { hash(key) } else { 0 }
}
record FileKey {
    file: File;
    n: i64
}
fn fileKeyHash(k: FileKey) -> i64 {
    k.n
}
fn fileKeyEquals(a: FileKey, b: FileKey) -> bool {
    a.n == b.n
}
fn fileKey(file: File) -> i64 {
    keyedBy(FileKey { file: file; n: 1 }, fileKeyHash, fileKeyEquals)
}
effect fn main() -> i64 {
    0
}
