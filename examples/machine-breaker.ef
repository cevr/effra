// A circuit breaker whose step is an effect function: it consults a probe
// service before half-opening. The machine plan records the step's failure
// and service rows as the declaration's terminal row and requirements.
error ProbeUnavailable

service Probe {
    effect fn healthy(endpoint: string) -> bool raises { ProbeUnavailable }
}

impl HealthyProbe for Probe {
    effect fn healthy(endpoint: string) -> bool raises { ProbeUnavailable } {
        endpoint == "primary"
    }
}

enum Breaker {
    Closed {
        failures: i64
    }
    Open {
        endpoint: string
    }
    HalfOpen {
        endpoint: string
    }
}

enum Signal {
    Failure {
        endpoint: string
    }
    Success
    Retry
    Retire
}

fn tripped(endpoint: string) -> Breaker {
    Breaker.Open {
        endpoint: endpoint
    }
}

effect fn breakerStep(state: Breaker, signal: Signal) -> decision<Breaker, string>
    raises { ProbeUnavailable }
    uses { Probe }
{
    match state, signal {
        Breaker.Closed { failures }, Signal.Failure { endpoint } => if failures >= 2 {
            enter tripped(endpoint)
        } else {
            stay Breaker.Closed(failures + 1)
        }
        Breaker.Closed, Signal.Success => stay Breaker.Closed(0)
        Breaker.Closed | Breaker.HalfOpen, Signal.Retry => ignore
        Breaker.Open { endpoint }, Signal.Retry => if run Probe.healthy(endpoint) {
            enter Breaker.HalfOpen(endpoint)
        } else {
            stay state
        }
        Breaker.Open | Breaker.HalfOpen, Signal.Failure { endpoint } => enter tripped(endpoint)
        Breaker.HalfOpen, Signal.Success => enter Breaker.Closed(0)
        Breaker.Open, Signal.Success => reject
        Breaker.Closed | Breaker.Open | Breaker.HalfOpen, Signal.Retire => done "retired"
    }
}

machine CircuitBreaker {
    initial Breaker.Closed {
        failures: 0
    }
    step breakerStep
}

fn describe(decision: decision<Breaker, string>) -> string {
    match decision {
        enter next => "go " + label(next)
        stay next => "stay " + label(next)
        ignore => "ignore"
        reject => "reject"
        done output => "done " + output
    }
}

fn label(state: Breaker) -> string {
    match state {
        Breaker.Closed => "closed"
        Breaker.Open { endpoint } => "open " + endpoint
        Breaker.HalfOpen { endpoint } => "half-open " + endpoint
    }
}

effect fn main() -> string raises { ProbeUnavailable } {
    let open = tripped("primary")
    let retried = run breakerStep(open, Signal.Retry {}).provide<Probe>(HealthyProbe)
    let failed = run breakerStep(Breaker.Closed {
            failures: 2
        }, Signal.Failure {
            endpoint: "primary"
        }).provide<Probe>(HealthyProbe)
    let retired = run breakerStep(open, Signal.Retire {}).provide<Probe>(HealthyProbe)
    describe(retried) + "; " + describe(failed) + "; " + describe(retired)
}
