import go strings "strings"
import go strconv "strconv"
import go sdk "effra.local/prototype/examples/sdk"

effect fn program() -> () uses {Foreign, Console} {
    let name = run strings.ToUpper("ada")
    run Console.log(name)
    let raw = run strconv.ParseBool("invalid")
    if raw.hasError { run Console.log("partial result retained") } else { () }
    let fallback = run strconv.ParseBool("invalid").orFail().catch<GoError>(false)
    let slow = run sdk.Lookup("slow").orFail().timeout(1)
        .catch<Timeout>("timed out").catch<GoError>("failed")
    run Console.log(slow)
}

effect fn main() -> () {
    run program().provide<Foreign>(Host).provide<Console>(Stdout)
}
