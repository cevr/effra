import go strings "strings"
import go sdk "effra.local/prototype/examples/sdk"

effect fn route(path: string) -> string raises {GoError} uses {Foreign, Files, Scheduler} {
    if path == "/health" { "ok" } else {
        if path == "/file" {
            run Files.readFile("examples/fixture.txt").catch<IoError>("file unavailable")
        } else {
            let id = run strings.TrimPrefix(path, "/users/")
            let user = run sdk.Lookup(id).orFail().timeout(100)
                .catch<Timeout>("timed out")
            "Hello, " + user
        }
    }
}

effect fn main() -> () raises {IoError} {
    run Http.serve("127.0.0.1:0", route)
        .provide<Http>(GoHttp)
        .provide<Foreign>(Host)
        .provide<Files>(LiveFiles)
        .provide<Scheduler>(LiveScheduler)
}
