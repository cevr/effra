error Missing

service Directory {
    effect fn name(id: string) -> string raises {Missing}
}

impl FixtureDirectory for Directory {
    effect fn name(id: string) -> string raises {Missing} {
        if id == "42" { "Ada" } else { fail Missing }
    }
}

effect fn greeting(id: string) -> string raises {Missing} uses {Directory} {
    let name = run Directory.name(id)
    "Hello, " + name
}

effect fn test_greeting() -> () raises {AssertionFailed, Missing} uses {Assert} {
    let actual = run greeting("42").provide<Directory>(FixtureDirectory)
    run Assert.equalText(actual, "Hello, Ada")
}

effect fn test_recovery() -> () raises {AssertionFailed} uses {Assert} {
    let actual = run greeting("unknown")
        .provide<Directory>(FixtureDirectory)
        .catch<Missing>("Unknown user")
    run Assert.equalText(actual, "Unknown user")
}

effect fn test_owned_child() -> () raises {AssertionFailed, Missing} uses {Assert} {
    scope {
        let child = fork greeting("42").provide<Directory>(FixtureDirectory)
        let actual = run child.join()
        run Assert.check(actual == "Hello, Ada", "owned child returns its result")
    }
}
