// Portable causal synchronization and scheduler-backed test fixtures.

effect fn waitFor(latch: Latch) -> void uses { Sync } {
    run Sync.await(latch)
}

effect fn sequentialSleeps() -> void uses { Clock } {
    run Clock.sleep(20)
    run Clock.sleep(30)
}
effect fn explicitVirtualSleep() -> void uses { Clock } {
    run Clock.sleep(20)
}
effect fn delayed() -> string uses { Clock } {
    run Clock.sleep(100)
    "late"
}

effect fn test_latch_signal_is_shared() -> void raises { AssertionFailed } uses { Assert, Sync } {
    let latch = run Sync.latch()
    run Sync.signal(latch)
    run Sync.await(latch)
    run Sync.signal(latch)
    run Assert.check(true, "a one-shot signal remains complete for every waiter")
}

effect fn test_latch_waiter_interrupt_is_independent() -> void raises { AssertionFailed } uses { Assert, Sync } {
    let latch = run Sync.latch()
    scope {
        let waiter = fork waitFor(latch)
        run waiter.interrupt()
        run Sync.signal(latch)
    }
    run Sync.await(latch)
    run Assert.check(true, "interrupting one waiter does not consume the latch")
}

effect fn test_scheduler_drains_sequential_deadlines() -> void raises { AssertionFailed } uses { Assert, Clock, Scheduler } {
    let child = fork sequentialSleeps()
    run Scheduler.awaitRegistration()
    run Scheduler.advance(50)
    run child.join()
    run Assert.check(true, "one advancement reaches sequential intermediate deadlines")
}

effect fn test_explicit_test_providers_share_harness() -> void raises { AssertionFailed } uses { Assert, Scheduler } {
    let child = fork explicitVirtualSleep().provide<Clock>(TestClock).provide<Scheduler>(TestScheduler)
    run Scheduler.awaitRegistration()
    run Scheduler.advance(20)
    run child.join()
    run Assert.check(true, "explicit test providers share the harness scheduler")
}

effect fn test_timeout_uses_the_test_scheduler() -> void raises { AssertionFailed, Timeout } uses { Assert, Clock, Scheduler } {
    let child = fork delayed().timeout(50)
    run Scheduler.awaitRegistration()
    run Scheduler.advance(50)
    let result = run child.join().catch<Timeout>("timed out")
    run Assert.equalText(result, "timed out")
}
