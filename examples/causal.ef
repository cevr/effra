// Portable causal synchronization and scheduler-backed test fixtures.

effect fn waitFor(latch: Latch) -> void uses { Sync } {
    run Sync.await(latch)
}

effect fn sequentialSleeps() -> void uses { Clock } {
    run Clock.sleep(20)
    run Clock.sleep(30)
}
effect fn explicitVirtualSleep() -> void uses { Clock } {
    run Clock.sleep(20)
}
effect fn delayed() -> string uses { Clock } {
    run Clock.sleep(100)
    "late"
}

effect fn test_latch_signal_is_shared() -> void raises { AssertionFailed } uses { Assert, Sync } {
    let latch = run Sync.latch()
    run Sync.signal(latch)
    run Sync.await(latch)
    run Sync.signal(latch)
    run Assert.check(true, "a one-shot signal remains complete for every waiter")
}

effect fn test_latch_waiter_interrupt_is_independent() -> void raises { AssertionFailed } uses { Assert, Sync } {
    let latch = run Sync.latch()
    scope {
        let waiter = fork waitFor(latch)
        run waiter.interrupt()
        run Sync.signal(latch)
    }
    run Sync.await(latch)
    run Assert.check(true, "interrupting one waiter does not consume the latch")
}

effect fn test_scheduler_drains_sequential_deadlines() -> void raises { AssertionFailed } uses { Assert, Clock, Scheduler } {
    let child = fork sequentialSleeps()
    run Scheduler.awaitRegistration()
    run Scheduler.advance(50)
    run child.join()
    run Assert.check(true, "one advancement reaches sequential intermediate deadlines")
}

effect fn test_explicit_test_providers_share_harness() -> void raises { AssertionFailed } uses { Assert, Scheduler } {
    let child = fork explicitVirtualSleep().provide<Clock>(TestClock).provide<Scheduler>(TestScheduler)
    run Scheduler.awaitRegistration()
    run Scheduler.advance(20)
    run child.join()
    run Assert.check(true, "explicit test providers share the harness scheduler")
}

effect fn test_timeout_uses_the_test_scheduler() -> void raises { AssertionFailed, Timeout } uses { Assert, Clock, Scheduler } {
    let child = fork delayed().timeout(50)
    run Scheduler.awaitRegistration()
    run Scheduler.advance(50)
    let result = run child.join().catch<Timeout>("timed out")
    run Assert.equalText(result, "timed out")
}

// Scheduler.awaitRegistration returns at quiescence: no managed fiber is
// running or runnable, and a wake in flight is not idle. It does not wait for
// a new timer, so forked work that already completed, or whose timeout timer
// was cancelled or never started, passes the barrier. Interrupting after the
// barrier proves the work settled before it returned: without the barrier the
// interrupt reaches unfinished work.

effect fn ready(latch: Latch) -> string uses { Sync } {
    run Sync.await(latch)
    "reached"
}
effect fn immediate() -> string {
    "immediate"
}
effect fn nestedImmediate() -> string {
    let inner = fork immediate()
    run inner.join()
}

effect fn test_barrier_after_immediately_completed_timeout() -> void raises { AssertionFailed, Timeout } uses { Assert, Clock, Scheduler, Sync } {
    let latch = run Sync.latch()
    run Sync.signal(latch)
    let probe = fork ready(latch).timeout(10)
    run Scheduler.awaitRegistration()
    run Scheduler.advance(10)
    run Assert.equalText(run probe.join(), "reached")
}

effect fn test_barrier_after_latch_signalled_before_fork() -> void raises { AssertionFailed } uses { Assert, Scheduler, Sync } {
    let latch = run Sync.latch()
    run Sync.signal(latch)
    let probe = fork ready(latch)
    run Scheduler.awaitRegistration()
    run probe.interrupt()
    run Assert.equalText(run probe.join(), "reached")
}

effect fn test_barrier_after_pure_fork_then_interrupt() -> void raises { AssertionFailed } uses { Assert, Scheduler } {
    let probe = fork immediate()
    run Scheduler.awaitRegistration()
    run probe.interrupt()
    run Assert.equalText(run probe.join(), "immediate")
}

effect fn test_barrier_after_completion_cancels_timeout() -> void raises { AssertionFailed, Timeout } uses { Assert, Clock, Scheduler, Sync } {
    let latch = run Sync.latch()
    let probe = fork ready(latch).timeout(10)
    run Scheduler.awaitRegistration()
    run Sync.signal(latch)
    run Scheduler.awaitRegistration()
    run probe.interrupt()
    run Assert.equalText(run probe.join(), "reached")
}

effect fn test_barrier_after_nested_fork() -> void raises { AssertionFailed } uses { Assert, Scheduler } {
    let probe = fork nestedImmediate()
    run Scheduler.awaitRegistration()
    run probe.interrupt()
    run Assert.equalText(run probe.join(), "immediate")
}

effect fn test_barrier_settles_mixed_sibling_forks() -> void raises { AssertionFailed, Timeout } uses { Assert, Clock, Scheduler, Sync } {
    let latch = run Sync.latch()
    run Sync.signal(latch)
    let pure = fork immediate()
    let timed = fork ready(latch).timeout(10)
    let nested = fork nestedImmediate()
    let sleeping = fork sleeper()
    run Scheduler.awaitRegistration()
    run pure.interrupt()
    run timed.interrupt()
    run nested.interrupt()
    run Assert.equalText(run pure.join(), "immediate")
    run Assert.equalText(run timed.join(), "reached")
    run Assert.equalText(run nested.join(), "immediate")
    run Scheduler.advance(1000)
    run sleeping.join()
}

// A cancelled wait wakes its fiber with no wake reservation, and the
// canceller then parks on that fiber's completion. Until the woken fiber
// runs again it is runnable, so the barrier must wait for it. Each worker
// parks a victim, gives it a turn by joining an immediate fork, then cancels
// it by interrupt or by closing its scope.

effect fn sleeper() -> void uses { Clock } {
    run Clock.sleep(1000)
}
effect fn interruptOwnSleeper() -> string uses { Clock } {
    let victim = fork sleeper()
    let turn = fork immediate()
    let given = run turn.join()
    run victim.interrupt()
    given + " marked"
}
effect fn interruptOwnWaiter(latch: Latch) -> string uses { Sync } {
    let victim = fork waitFor(latch)
    let turn = fork immediate()
    let given = run turn.join()
    run victim.interrupt()
    given + " marked"
}
effect fn closeOverSleeper() -> string uses { Clock } {
    let given = scope {
        let victim = fork sleeper()
        let turn = fork immediate()
        run turn.join()
    }
    given + " marked"
}

effect fn test_barrier_after_interrupting_a_sleeper() -> void raises { AssertionFailed } uses { Assert, Clock, Scheduler } {
    let worker = fork interruptOwnSleeper()
    run Scheduler.awaitRegistration()
    run worker.interrupt()
    run Assert.equalText(run worker.join(), "immediate marked")
}

effect fn test_barrier_after_interrupting_a_latch_waiter() -> void raises { AssertionFailed } uses { Assert, Scheduler, Sync } {
    let latch = run Sync.latch()
    let worker = fork interruptOwnWaiter(latch)
    run Scheduler.awaitRegistration()
    run worker.interrupt()
    run Assert.equalText(run worker.join(), "immediate marked")
}

effect fn test_barrier_after_scope_close() -> void raises { AssertionFailed } uses { Assert, Clock, Scheduler } {
    let worker = fork closeOverSleeper()
    run Scheduler.awaitRegistration()
    run worker.interrupt()
    run Assert.equalText(run worker.join(), "immediate marked")
}

// A latch signal resumes its waiter while the signaller is still mid-turn.
// Readiness is not registration: the barrier and each deadline selection of
// advance wait until the signaller has parked on its next timer too.

effect fn signalThenSleep(ready: Latch) -> string uses { Clock, Sync } {
    run Sync.signal(ready)
    run Clock.sleep(10)
    "woke"
}

effect fn test_barrier_after_readiness_then_advance() -> void raises { AssertionFailed } uses { Assert, Clock, Scheduler, Sync } {
    let ready = run Sync.latch()
    let worker = fork signalThenSleep(ready)
    run Sync.await(ready)
    run Scheduler.awaitRegistration()
    run Scheduler.advance(10)
    run Assert.equalText(run worker.join(), "woke")
}

effect fn test_advance_after_readiness() -> void raises { AssertionFailed } uses { Assert, Clock, Scheduler, Sync } {
    let ready = run Sync.latch()
    let worker = fork signalThenSleep(ready)
    run Sync.await(ready)
    run Scheduler.advance(10)
    run Assert.equalText(run worker.join(), "woke")
}

// The resumed waiter can itself resume another and advance. The releaser
// signals the relay, which signals the test and then advances, all while the
// releaser is still inside its signal.

effect fn relay(released: Latch, ready: Latch) -> void uses { Scheduler, Sync } {
    run Sync.await(released)
    run Sync.signal(ready)
    run Scheduler.advance(0)
}
effect fn release(released: Latch) -> string uses { Sync } {
    run Sync.signal(released)
    "released"
}

effect fn test_barrier_after_nested_resumption() -> void raises { AssertionFailed } uses { Assert, Scheduler, Sync } {
    let released = run Sync.latch()
    let ready = run Sync.latch()
    let relayer = fork relay(released, ready)
    let releaser = fork release(released)
    run Sync.await(ready)
    run Scheduler.awaitRegistration()
    run releaser.interrupt()
    run Assert.equalText(run releaser.join(), "released")
    run relayer.join()
}
