// A program of the decided language (docs/spec/ v0) inside the prototype
// checker's subset: rows, try, catch, a closed wire and timeout.After.

type NotFound { Name string }

type Greeter {
	Greet(name string) string fails NotFound,
}

type Friends {}

func Greet(_ Friends, name string) string fails NotFound {
	if name == "Ada" {
		return "hello, " + name
	}
	return NotFound{Name: name}
}

let Live = wire {
	Greeter: Friends{},
}

func greet(name string) needs Console {
	let line = with Live { Greeter.Greet(name) } catch {
	case NotFound:
		"no friend named " + name
	}
	Console.Println(line)
}

func main() needs Console {
	greet("Ada")
	greet("Bob")
}
