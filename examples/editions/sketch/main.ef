// A module of the 2026 edition (docs/spec/ v0): the ergo.json beside this
// file selects the Go-shaped front-end. The same workspace builds the
// earlier edition's module in ../legacy.
package editions

type NotFound struct{ Name string }

type Greeter interface {
	Greet(name string) (string, error[NotFound])
}

type Friends struct{}

func (Friends) Greet(name string) (string, error[NotFound]) {
	if name == "Ada" {
		return "hello, " + name
	}
	return NotFound{Name: name}
}

wire Live {
	Greeter = Friends{}
}

func greet(name string) needs Console {
	line := with(Live) { Greeter.Greet(name) } catch {
	case NotFound:
		"no friend named " + name
	}
	Console.Println(line)
}

func main() needs Console {
	greet("Ada")
	greet("Bob")
}
