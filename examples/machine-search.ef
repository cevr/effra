// A search box with reload: one checked machine declaration over an
// ordinary pure step function. `ef inspect examples/machine-search.ef Search`
// and `ef graph examples/machine-search.ef --kind machine` project its plan
// without running the step.
import Machines "effra/machines"

enum Query {
    Idle
    Loading {
        text: string
    }
    Ready {
        text: string
        hits: i64
    }
    Failed {
        text: string
    }
}

enum QueryEvent {
    Submit {
        text: string
    }
    Results {
        hits: i64
    }
    Errored
    Reload
    Close
}

fn loading(text: string) -> Query {
    Query.Loading {
        text: text
    }
}

fn searchStep(state: Query, event: QueryEvent) -> Machines.Step<Query, i64> {
    match state, event {
        Query.Idle | Query.Ready | Query.Failed, QueryEvent.Submit { text } => Machines.Step<Query, i64>.Go(loading(text))
        Query.Loading { text: current }, QueryEvent.Submit { text } => if text == current {
            Machines.Step<Query, i64>.Stay(state)
        } else {
            Machines.Step<Query, i64>.Go(loading(text))
        }
        Query.Loading { text }, QueryEvent.Results { hits } => Machines.Step<Query, i64>.Go(Query.Ready(text, hits))
        Query.Loading { text }, QueryEvent.Errored => Machines.Step<Query, i64>.Go(Query.Failed(text))
        Query.Ready { text } | Query.Failed { text }, QueryEvent.Reload => Machines.Step<Query, i64>.Go(loading(text))
        Query.Idle | Query.Loading, QueryEvent.Reload => Machines.Step<Query, i64>.Ignore {}
        Query.Idle | Query.Ready | Query.Failed, QueryEvent.Results | QueryEvent.Errored => Machines.Step<Query, i64>.Ignore {}
        Query.Ready { hits }, QueryEvent.Close => Machines.Step<Query, i64>.Done(hits)
        Query.Idle | Query.Loading | Query.Failed, QueryEvent.Close => Machines.Step<Query, i64>.Reject {}
    }
}

machine Search {
    initial Query.Idle {}
    step searchStep
}

// The demo applies decisions by hand; executing a machine belongs to a
// runtime provider, which this profile does not admit yet.
fn describe(decision: Machines.Step<Query, i64>) -> string {
    match decision {
        Machines.Step.Go { next } => "go " + label(next)
        Machines.Step.Stay { next } => "stay " + label(next)
        Machines.Step.Ignore => "ignore"
        Machines.Step.Reject => "reject"
        Machines.Step.Done => "done"
    }
}

fn label(state: Query) -> string {
    match state {
        Query.Idle => "idle"
        Query.Loading { text } => "loading " + text
        Query.Ready { text } => "ready " + text
        Query.Failed { text } => "failed " + text
    }
}

effect fn main() -> string {
    let loading = Query.Loading {
        text: "ada"
    }
    describe(searchStep(Query.Idle {}, QueryEvent.Submit {
                text: "ada"
            })) + "; " + describe(searchStep(loading, QueryEvent.Submit {
                text: "ada"
            })) + "; " + describe(searchStep(loading, QueryEvent.Results {
                hits: 3
            })) + "; " + describe(searchStep(Query.Idle {}, QueryEvent.Close {}))
}
