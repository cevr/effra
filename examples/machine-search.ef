// A search box with reload: one checked machine declaration over an
// ordinary pure step function. `ef inspect examples/machine-search.ef Search`
// and `ef graph examples/machine-search.ef --kind machine` project its plan
// without running the step.
enum Query {
    Idle
    Loading {
        text: string
    }
    Ready {
        text: string
        hits: i64
    }
    Failed {
        text: string
    }
}

enum QueryEvent {
    Submit {
        text: string
    }
    Results {
        hits: i64
    }
    Errored
    Reload
    Close
}

fn loading(text: string) -> Query {
    Query.Loading {
        text: text
    }
}

fn searchStep(state: Query, event: QueryEvent) -> decision<Query, i64> {
    match state, event {
        Query.Idle | Query.Ready | Query.Failed, QueryEvent.Submit { text } => enter loading(text)
        Query.Loading { text: current }, QueryEvent.Submit { text } => if text == current {
            stay state
        } else {
            enter loading(text)
        }
        Query.Loading { text }, QueryEvent.Results { hits } => enter Query.Ready(text, hits)
        Query.Loading { text }, QueryEvent.Errored => enter Query.Failed(text)
        Query.Ready { text } | Query.Failed { text }, QueryEvent.Reload => enter loading(text)
        Query.Idle | Query.Loading, QueryEvent.Reload => ignore
        Query.Idle | Query.Ready | Query.Failed, QueryEvent.Results | QueryEvent.Errored => ignore
        Query.Ready { hits }, QueryEvent.Close => done hits
        Query.Idle | Query.Loading | Query.Failed, QueryEvent.Close => reject
    }
}

machine Search {
    initial Query.Idle {}
    step searchStep
}

// The demo applies decisions by hand; executing a machine belongs to a
// runtime provider, which this profile does not admit yet.
fn describe(decision: decision<Query, i64>) -> string {
    match decision {
        enter next => "enter " + label(next)
        stay next => "stay " + label(next)
        ignore => "ignore"
        reject => "reject"
        done => "done"
    }
}

fn label(state: Query) -> string {
    match state {
        Query.Idle => "idle"
        Query.Loading { text } => "loading " + text
        Query.Ready { text } => "ready " + text
        Query.Failed { text } => "failed " + text
    }
}

effect fn main() -> string {
    let loading = Query.Loading {
        text: "ada"
    }
    describe(searchStep(Query.Idle {}, QueryEvent.Submit {
                text: "ada"
            })) + "; " + describe(searchStep(loading, QueryEvent.Submit {
                text: "ada"
            })) + "; " + describe(searchStep(loading, QueryEvent.Results {
                hits: 3
            })) + "; " + describe(searchStep(Query.Idle {}, QueryEvent.Close {}))
}
