// control: an inline wire key names the capability; the key and both calls are qualified (round-2 review probe)
// expect (a): qualified 3, row kept 0
// expect (b): unique 3, ambiguous 0, lexical 0, unresolved 0
package demo

import "http"

type Fake struct{}

func (Fake) Ping() {}

func work() uses http.Client {
	Client.Ping()
	with(wire{ Client = Fake{} }) { Client.Ping() }
}
