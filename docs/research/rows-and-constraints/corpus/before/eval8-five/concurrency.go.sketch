package concurrency

import "timeout"

type Bad struct{}

func immediate() string {
	return "child joined"
}

func pending() string uses Clock {
	Clock.Sleep(10s)
	return "late"
}

func bad() (string, error[Bad]) {
	return Bad{}
}

// Every task is consumed by Wait or Stop before the function returns.
func program() error[Bad] uses Clock, Console, Scheduler {
	child := go immediate()
	Console.Println(child.Wait())

	stopped := go pending()
	stopped.Stop() // interrupts it and waits for its cleanup

	deadline := timeout.After(1ms, pending) catch {
	case timeout.Expired:
		"timed out"
	}
	Console.Println(deadline)

	failed := go bad()
	recovered := failed.Wait() catch {
	case Bad:
		"recovered"
	}
	Console.Println(recovered)
	return
}

func main() error[Bad] uses Clock, Console, Scheduler {
	return program()
}
