package poller

import (
	"time"
	"timeout"
)

type SourceDown struct{}
type FlushFailed struct{}

type Reading struct {
	At    time.Time
	Value float64
}

type Source interface {
	Read() (float64, error[SourceDown])
}

type Sink interface {
	Flush(batch []Reading) error[FlushFailed]
}

// The ticker stops when the loop ends. A full channel blocks the send.
func poll(out chan Reading) uses Source, Clock, Console {
	for at := range Clock.Tick(1s) {
		v := Source.Read() catch {
		case SourceDown:
			Console.Println("poll failed")
			continue
		}
		out <- Reading{at, v}
	}
}

func batch(in chan Reading, size int) error[FlushFailed] uses Sink {
	var buf []Reading
	for r := range in {
		buf = append(buf, r)
		if len(buf) == size {
			try Sink.Flush(buf)
			buf = buf[:0]
		}
	}
	if len(buf) > 0 {
		try Sink.Flush(buf)
	}
}

// A flush failure exits Run, and that exit stops the producer.
func Run(d time.Duration) error[FlushFailed] uses Source, Sink, Clock, Scheduler, Console {
	ch := make(chan Reading, 16)
	producer := go {
		defer close(ch)
		timeout.After(d) { poll(ch) } catch {
		case timeout.Expired:
		}
	}
	try batch(ch, 5)
	producer.Wait()
}
