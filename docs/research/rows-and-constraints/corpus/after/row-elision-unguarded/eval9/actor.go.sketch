package breaker

import (
	"actor"
	"schedule"
	"tasks"
)

// The CircuitBreaker machine, Breaker, Signal and breakerStep are the ones in
// sketch-eval-8/five/machine-breaker.go.sketch.

// actor.Start runs a machine as an actor: one task that owns the state and
// reads a bounded mailbox, one message at a time. The actor is a linear
// handle like a Task: it must be stopped or awaited before main returns.
func main() (string, error[ProbeUnavailable]) uses Console {
	return with(wire{ Probe = HealthyProbe{} }) {
		b := actor.Start(CircuitBreaker{}, 16)
		defer b.Stop()

		b.Send(Failure{"primary"}) // fire and forget; blocks only when the mailbox is full
		b.Send(Failure{"primary"})
		tripped := try b.Ask(Failure{"primary"}) // waits for this message's decision
		retried := try b.Ask(Retry{})

		Console.Println(label(b.State())) // a snapshot, never a shared reference
		describe(tripped) + "; " + describe(retried)
	}
}

// Supervision: the actor runs inside a tasks.Set with a restart policy. A
// restart starts again from the machine's initial state; ef ps shows the
// restart count.
// The Set sits inside the Probe binding, so every restart and the final
// shutdown happen while Probe is still provided. The factory captures
// nothing linear, so it can run again.
func supervised() {
	with(wire{ Probe = HealthyProbe{} }) {
		set := tasks.Set(tasks.Restart(schedule.Exponential(1s).UpTo(5)))
		defer set.Stop()
		set.Go(func() { actor.Run(CircuitBreaker{}, signals()) })
	}
}
