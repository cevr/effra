// docs/spec/resources.md#block0, rewritten by measure.py for candidate row-elision-unguarded
func copyFile(src, dst string) {
	in := try FS.Open(src)
	out := try FS.Create(dst) // if this fails, in is still closed
	try io.Copy(out, in)      // lends out and in
}                             // out closed, then in
