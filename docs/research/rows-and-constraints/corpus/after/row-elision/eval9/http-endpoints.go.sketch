package shop

import (
	"http"
	"json"
	"testing"
)

type UnknownMember struct{ ID string }
type OutOfStock struct{ Item string }
type Unpublishable struct{ Cents int64 }
type NothingToCancel struct{}

// A member is resolved through Directory while decoding: the wire carries
// only its identifier.
type Member struct {
	ID   string
	Name string
}

type Directory interface {
	Find(id string) (Member, error[UnknownMember])
}

func ParseMember(id string) (Member, error[UnknownMember]) uses Directory {
	return Directory.Find(id)
}

func (m Member) Wire() string { return m.ID }

type Order struct {
	Member   Member
	Item     string
	Quantity int64
}

// A total is published through Ledger while encoding, which refuses large
// totals: the success encoder itself can fail with a named failure.
type Total struct{ Cents int64 }

type Ledger interface {
	Publish(cents int64) (int64, error[Unpublishable])
}

func ParseTotal(cents int64) Total { return Total{cents} }

func (t Total) Wire() (int64, error[Unpublishable]) uses Ledger {
	return Ledger.Publish(t.Cents)
}

type Receipt struct {
	Item  string
	Total Total
}

type Inventory interface {
	Reserve(item string, quantity int64) (int64, error[OutOfStock])
}

func place(order Order) Receipt {
	cents := try Inventory.Reserve(order.Item, order.Quantity)
	return Receipt{order.Item, Total{cents}}
}

// A handler is an ordinary function from Request to Response. A catch with
// no try must cover every error, so the checker rejects a handler that
// leaves a decode, handler or encode failure without a status.
func placeOrder(req http.Request) http.Response {
	return created(req) catch e {
	case http.UnsupportedMediaType:
		http.Status(415)
	case json.DecodeFailed:
		http.Status(400)
	case UnknownMember:
		http.Fail(422, e)
	case OutOfStock:
		http.Fail(409, e)
	case Unpublishable:
		http.Status(502)
	}
}

func created(req http.Request) http.Response {
	order := try http.ReadJSON[Order](req, 256)
	return http.JSON(201, try place(order))
}

func cancelOrder(req http.Request) http.Response {
	return http.Status(409) // empty body, as in Effra
}

func health(req http.Request) http.Response {
	return http.Status(204)
}

// Go 1.22 ServeMux patterns. The checker parses each pattern.
var api = http.Routes{
	"POST /orders":   placeOrder,
	"DELETE /orders": cancelOrder,
	"GET /health":    health,
}

type Members struct{}

func (Members) Find(id string) (Member, error[UnknownMember]) {
	if id == "m-1" {
		return Member{id, "Ada"}
	}
	return UnknownMember{id}
}

type Stock struct{}

func (Stock) Reserve(item string, quantity int64) (int64, error[OutOfStock]) {
	if quantity > 4 {
		return OutOfStock{item}
	}
	return quantity + 250
}

type Books struct{}

func (Books) Publish(cents int64) (int64, error[Unpublishable]) {
	if cents > 252 {
		return Unpublishable{cents}
	}
	return cents
}

wire Shop {
	Directory = Members{}
	Inventory = Stock{}
	Ledger = Books{}
}

// A stored-data caller decodes with the same wire forms outside HTTP.
func restoreOrder(stored string) Order {
	return json.Decode[Order](stored)
}

// Calling the route table directly needs no server. Every failure is
// mapped, so the result has no error row.
func order(contentType string, body string) int {
	return api.Serve(http.Request{Method: "POST", Path: "/orders", ContentType: contentType, Body: body}).Status
}

func TestOrderIsCreated() {
	with(Shop) {
		T.Equal(order("application/json", `{"member":"m-1","item":"tea","quantity":"2"}`), 201)
	}
}

func TestUnknownMemberIsNotMalformedInput() {
	with(Shop) {
		T.Equal(order("application/json", `{"member":"m-9","item":"tea","quantity":"2"}`), 422)
		T.Equal(order("application/json", `{"member":"m-1"}`), 400)
	}
}

func TestHandlerFailureAnswersItsStatus() {
	with(Shop) {
		T.Equal(order("application/json", `{"member":"m-1","item":"tea","quantity":"9"}`), 409)
	}
}

func TestUnsupportedMediaType() {
	with(Shop) {
		T.Equal(order("text/plain", "{}"), 415)
	}
}

func TestStoredOrderSharesTheWireForms() {
	order := try with(Shop) { restoreOrder(`{"member":"m-1","item":"tea","quantity":"1"}`) }
	T.Equal(order.Member.Name, "Ada")
}

func main() error[http.ListenFailed] uses http.Server {
	limits := http.Limits{MaxBodyBytes: 256, ReadHeader: 1s, ReadBody: 1s, Idle: 1s, MaxActive: 8}
	return with(Shop) { Server.Listen("127.0.0.1:0", limits, api) }
}
