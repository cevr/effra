// Deferred effects, nominal services, and selective recovery.
// Hand migration of examples/main.ef to the 2026 edition (docs/spec/ v0).

type NotFound {}

type Users {
	Get(id string) string fails NotFound,
}

type MemoryUsers {}

func Get(_ MemoryUsers, id string) string fails NotFound {
	if id == "42" {
		return "Ada"
	}
	return NotFound{}
}

func welcome(name string) string {
	return "Hello, " + name
}

func greeting(id string) string fails NotFound needs Users {
	let user = try Users.Get(id)
	return welcome(user)
}

func main() needs Console {
	let found = with wire { Users: MemoryUsers{} } { greeting("42") } catch {
	case NotFound:
		"Unknown user"
	}
	Console.Println(found)

	let absent = with wire { Users: MemoryUsers{} } { greeting("missing") } catch {
	case NotFound:
		"Unknown user"
	}
	Console.Println(absent)
}
