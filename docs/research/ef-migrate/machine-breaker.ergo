// A circuit breaker whose step is an effect function: it consults a probe
// service before half-opening. The machine plan records the step's failure
// and service rows as the declaration's terminal row and requirements.
// Hand migration of examples/machine-breaker.ef to the 2026 edition
// (docs/spec/ v0, runtime.md "Machines and actors"). The Decision variant
// field names Next and Output are provisional: the spec shows only
// positional literals.

type ProbeUnavailable {}

type Probe {
	Healthy(endpoint string) bool fails ProbeUnavailable,
}

type HealthyProbe {}

func Healthy(_ HealthyProbe, endpoint string) bool fails ProbeUnavailable {
	return endpoint == "primary"
}

type Breaker = Closed | Open | HalfOpen

type Closed { failures int64 }
type Open { endpoint string }
type HalfOpen { endpoint string }

type Signal = Failure | Success | Retry | Retire

type Failure { endpoint string }
type Success {}
type Retry {}
type Retire {}

func tripped(endpoint string) Breaker {
	return Open{endpoint: endpoint}
}

func breakerStep(state Breaker, signal Signal) Decision[Breaker, string] fails ProbeUnavailable needs Probe {
	match (state, signal) {
	case (Closed, Failure):
		if state.failures >= 2 {
			return Enter{tripped(signal.endpoint)}
		}
		return Stay{Closed{state.failures + 1}}
	case (Closed, Success):
		return Stay{Closed{0}}
	case (Closed, Retry), (HalfOpen, Retry):
		return Ignore{}
	case (Open, Retry):
		let healthy = try Probe.Healthy(state.endpoint)
		if healthy {
			return Enter{HalfOpen{state.endpoint}}
		}
		return Stay{state}
	case (Open, Failure), (HalfOpen, Failure):
		return Enter{tripped(signal.endpoint)}
	case (HalfOpen, Success):
		return Enter{Closed{0}}
	case (Open, Success):
		return Reject{}
	case (_, Retire):
		return Done{"retired"}
	}
}

type CircuitBreaker machine[Breaker, Signal] {
	initial: Closed{failures: 0},
	step:    breakerStep,
}

func describe(decision Decision[Breaker, string]) string {
	match decision {
	case Enter as d:
		return "enter " + label(d.Next)
	case Stay as d:
		return "stay " + label(d.Next)
	case Ignore:
		return "ignore"
	case Reject:
		return "reject"
	case Done as d:
		return "done " + d.Output
	}
}

func label(state Breaker) string {
	match state {
	case Closed:
		return "closed"
	case Open as s:
		return "open " + s.endpoint
	case HalfOpen as s:
		return "half-open " + s.endpoint
	}
}

func main() fails ProbeUnavailable needs Console {
	let open = tripped("primary")
	let retried = try with wire { Probe: HealthyProbe{} } { breakerStep(open, Retry{}) }
	let failed = try with wire { Probe: HealthyProbe{} } { breakerStep(Closed{failures: 2}, Failure{endpoint: "primary"}) }
	let retired = try with wire { Probe: HealthyProbe{} } { breakerStep(open, Retire{}) }
	Console.Println(describe(retried) + "; " + describe(failed) + "; " + describe(retired))
}
