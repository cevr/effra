// Hand migration of examples/data.ef to the 2026 edition (docs/spec/ v0).

type Request {
	id   string,
	name string,
}

type State = Idle | Running | Done

type Idle {}
type Running { requestId string }
type Done { requestId string }

type Invalid { message string }

func describe(state State) string {
	match state {
	case Idle:
		return "idle"
	case Running as s:
		return "running " + s.requestId
	case Done as s:
		return "done " + s.requestId
	}
}

func main() needs Console {
	let request = Request{id: "42", name: "Ada"}
	let state = Running{requestId: request.id}
	Console.Println(describe(state))
}
