// Deferred effects, nominal services, and selective recovery.
// Hand migration of examples/main.ef to the 2026 edition (docs/spec/ v0).
package main

type NotFound struct{}

type Users interface {
	Get(id string) (string, error[NotFound])
}

type MemoryUsers struct{}

func (MemoryUsers) Get(id string) (string, error[NotFound]) {
	if id == "42" {
		return "Ada"
	}
	return NotFound{}
}

func welcome(name string) string {
	return "Hello, " + name
}

func greeting(id string) (string, error[NotFound]) needs Users {
	user := try Users.Get(id)
	return welcome(user)
}

func main() needs Console {
	found := with(wire{ Users = MemoryUsers{} }) { greeting("42") } catch {
	case NotFound:
		"Unknown user"
	}
	Console.Println(found)

	absent := with(wire{ Users = MemoryUsers{} }) { greeting("missing") } catch {
	case NotFound:
		"Unknown user"
	}
	Console.Println(absent)
}
