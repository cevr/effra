// Hand migration of examples/data.ef to the 2026 edition (docs/spec/ v0).
package main

type Request struct {
	id   string
	name string
}

type State interface{ Idle | Running | Done }

type Idle struct{}
type Running struct{ requestId string }
type Done struct{ requestId string }

type Invalid struct{ message string }

func describe(state State) string {
	switch s := state.(type) {
	case Idle:
		return "idle"
	case Running:
		return "running " + s.requestId
	case Done:
		return "done " + s.requestId
	}
}

func main() uses Console {
	request := Request{id: "42", name: "Ada"}
	state := Running{requestId: request.id}
	Console.Println(describe(state))
}
