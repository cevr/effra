error Bad

effect fn immediate() -> string {
    "child joined"
}
effect fn pending() -> string uses { Clock } {
    run Clock.sleep(10s);
    "late"
}
effect fn bad() -> string raises { Bad } {
    fail Bad
}

effect fn program() -> void raises { Bad } uses { Clock, Console } {
    let child = run immediate().fork()
    let text = run child.join()
    run Console.log(text)
    let stopped = run pending().fork()
    run stopped.interrupt()
    let deadline = run pending().timeoutOr(1ms, "timed out")
    run Console.log(deadline)
    let failed = run bad().fork()
    let recovered = run failed.join().catch<Bad>("recovered")
    run Console.log(recovered)
}
effect fn main() -> void raises { Bad } {
    run program().scoped().provide<Clock>(LiveClock).provide<Console>(Stdout)
}
