// A File acquired in a nested owner is consumed before that owner closes.
// borrowOuter shows the separate borrowed-handle case.
effect fn borrowOuter(file: File) -> File {
    scope {
        let alias = file
        alias
    }
}

effect fn scopedRead() -> string raises { IoError } {
    // A provide block owns what its body acquires (note §6.5), so the File
    // is read inside the block and closes with it.
    provide Files = LiveFiles {
        let file = run Files.openRead("examples/fixture.txt")
        run Files.readText(file)
    }
}

effect fn main() -> string raises { IoError } {
    run scopedRead()
}
