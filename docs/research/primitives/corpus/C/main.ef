// Deferred effects, nominal services, and selective recovery.
error NotFound

service Users {
    effect fn get(id: string) -> string raises { NotFound }
}

impl MemoryUsers for Users {
    effect fn get(id: string) -> string raises { NotFound } {
        if id == "42" {
            "Ada"
        } else {
            fail NotFound
        }
    }
}

fn welcome(name: string) -> string {
    "Hello, " + name
}

effect fn greeting(id: string) -> string
    raises { NotFound }
    uses { Users }
{
    let user = run Users.get(id)
    welcome(user)
}

effect fn main() -> void {
    let found = provide Users = MemoryUsers {
        run greeting("42").catch<NotFound>("Unknown user")
    }
    provide Console = Stdout {
        run Console.log(found)
    }

    let absent = provide Users = MemoryUsers {
        run greeting("missing").catch<NotFound>("Unknown user")
    }
    provide Console = Stdout {
        run Console.log(absent)
    }
}
