error Denied
error UserMissing
error DeliveryFailed

service Access {
    effect fn check(id: string) -> void raises { Denied }
}

service Directory {
    effect fn name(id: string) -> string raises { UserMissing }
}

service Delivery {
    effect fn send(message: string) -> string raises { DeliveryFailed }
}

impl DemoAccess for Access {
    effect fn check(id: string) -> void raises { Denied } {
        if id == "blocked" {
            fail Denied
        } else {
            void
        }
    }
}

impl DemoDirectory for Directory {
    effect fn name(id: string) -> string raises { UserMissing } {
        if id == "42" {
            "Ada"
        } else {
            fail UserMissing
        }
    }
}

impl DemoDelivery for Delivery {
    effect fn send(message: string) -> string raises { DeliveryFailed } {
        if message == "" {
            fail DeliveryFailed
        } else {
            "queued: " + message
        }
    }
}

effect fn welcome(id: string) -> string
    raises { Denied, UserMissing, DeliveryFailed }
    uses { Access, Directory, Delivery }
{
    run Access.check(id)
    let name = run Directory.name(id)
    run Delivery.send("Welcome, " + name)
}

effect fn main() -> void {
    let accepted = run welcome("42")
        .provide<Access>(DemoAccess)
        .provide<Directory>(DemoDirectory)
        .provide<Delivery>(DemoDelivery)
        .catch<Denied>("access denied")
        .catch<UserMissing>("user missing")
        .catch<DeliveryFailed>("delivery failed")
    run Console.log(accepted).provide<Console>(Stdout)

    let rejected = run welcome("blocked")
        .provide<Access>(DemoAccess)
        .provide<Directory>(DemoDirectory)
        .provide<Delivery>(DemoDelivery)
        .catch<Denied>("access denied")
        .catch<UserMissing>("user missing")
        .catch<DeliveryFailed>("delivery failed")
    run Console.log(rejected).provide<Console>(Stdout)
}
