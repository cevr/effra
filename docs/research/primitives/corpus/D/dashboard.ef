service Store {
    effect fn label() -> string
}
service Account {
    effect fn label() -> string
}
service Invoice {
    effect fn label() -> string
}
impl Memory(label: string) for Store {
    effect fn label() -> string {
        label
    }
}
impl AccountLive for Account uses { Store } {
    effect fn label() -> string {
        run Store.label()
    }
}
impl InvoiceLive for Invoice uses { Store } {
    effect fn label() -> string {
        run Store.label()
    }
}
layer App provides { Account, Invoice } {
    Store = Memory("live");
    Account = AccountLive;
    Invoice = InvoiceLive
}

// One unit of work: fork one lookup, time-box the other, join, all inside a scope.
// `with f(args)` passes the rest of the block to f as a block argument.
effect fn dashboard() -> string uses { Account, Invoice, Clock } {
    with scoped()
    let account = fork Account.label()
    let invoice = run Invoice.label().timeoutOr(500ms, "invoice: slow")
    let name = run account.join()
    name + " / " + invoice
}

// The whole thing: provide the layer and the clock, then a deadline on the unit.
effect fn main() -> string {
    with provide(App)
    with provideService<Clock>(LiveClock)
    with timeoutOr(2s, "gave up")
    run dashboard()
}
