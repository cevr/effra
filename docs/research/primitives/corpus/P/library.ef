// Option P (losing option after review 1): a small kernel of built-in
// operations, exposed as methods in a bundled module, and everything else as
// library over it. Review 1 (B1) showed that fork, join and interrupt have no
// clause in the declared-contract vocabulary, so they would stay
// compiler-known: constructs in dot form. The signatures are kept here as the
// record of what P proposed; see primitives.md section 7.
//
// The kernel is a protocol. A provider of `Runtime` implements the six
// operations below and passes the law suite; the Effect runtime (JS), the Go
// runtime, the deterministic test scheduler, a UI frame scheduler or a
// request-scoped server runtime are all providers. Programs do not change
// between providers; only the `provide` does.
//
// Depends on features that are designed but not built:
//   - receiver methods (#127) for the dot spelling;
//   - whole-value type parameters `A: type` (#128, Q9);
//   - row difference `{ R - S }` (F3b, #126) for scoped and provide;
//   - the closed-at-the-edge recipe-parameter contract (#128, rows note Q11),
//     which carries the owner guarantee (nothing a closed owner owns escapes);
//   - declared ownership contracts in inferred vocabulary (#130) for fork;
//   - a `Duration` type with unit literals.
import Data "effra/data"

// ---- Kernel (built in; laws in the note, section "Kernel laws") ----

// Run `work` as a child of the current owner; the handle is owned by that owner.
pub effect fn (work: Effect<A, { E }, { R }>) fork<A: type, E: raises, R: uses>() -> Fiber<A, { E }> uses { R }

// Wait for the child; its failures surface here.
pub effect fn (child: Fiber<A, { E }>) join<A: type, E: raises>() -> A raises { E }

// Cancel the child and wait for its cleanup. A child that already completed
// with a failure re-raises it here (runtime.md; fiber.go, interrupt.mjs), so
// the row is the child's (review 1, M2).
pub effect fn (child: Fiber<A, { E }>) interrupt<A: type, E: raises>() -> void raises { E }

// First completion wins (success or failure). The loser is interrupted and its
// cleanup awaited before the result is published; its ordinary failures are
// abandoned. Each side runs under its own closed owner.
pub effect fn (left: Effect<A, { E }, { R }>) race<A: type, E: raises, R: uses, F: raises, S: uses>(right: Effect<A, { F }, { S }>) -> A raises { E, F } uses { R, S }

// Run `work` under a fresh owner: its children and resources close, in reverse
// order, when it ends. Removes `Scope` (acquired resources) from the row.
pub effect fn (work: Effect<A, { E }, { R }>) scoped<A: type, E: raises, R: uses>() -> A raises { E } uses { R - Scope }

// Register a finalizer on the current owner (Effect's acquireRelease).
pub effect fn acquireRelease<A: type, E: raises, R: uses>(acquire: Effect<A, { E }, { R }>, release: fn(A) -> Effect<void, {}, {}>) -> A raises { E } uses { R, Scope }

// ---- Provision: library over the context kernel ----

// Build `layer` around `work`. The plan lives on the `layer` declaration
// (`Layer<Out, E, In>` is the declaration's type), so graph, lint and
// inspection read it there; this call only applies it.
pub effect fn (work: Effect<A, { E }, { R }>) provide<A: type, E: raises, R: uses, Out: uses, F: raises, In: uses>(layer: Layer<Out, { F }, { In }>) -> A raises { E, F } uses { R - Out, In }

// Install one provider for one service.
pub effect fn (work: Effect<A, { E }, { R }>) provide<S: service, A: type, E: raises, R: uses>(provider: S) -> A raises { E } uses { R - S }

// ---- Time: library over race and Clock.sleep ----

pub error Timeout

pub effect fn (work: Effect<A, { E }, { R }>) timeout<A: type, E: raises, R: uses>(limit: Duration) -> A raises { E, Timeout } uses { R, Clock } {
    run work.race(failAfter(limit))
}

pub effect fn (work: Effect<A, { E }, { R }>) timeoutOr<A: type, E: raises, R: uses>(limit: Duration, fallback: A) -> A raises { E } uses { R, Clock } {
    run work.race(after(limit, fallback))
}

pub effect fn (work: Effect<A, { E }, { R }>) timeoutOption<A: type, E: raises, R: uses>(limit: Duration) -> Data.Option<A> raises { E } uses { R, Clock } {
    run someOf(work).race(after(limit, Data.Option<A>.None {}))
}

effect fn someOf<A: type, E: raises, R: uses>(work: Effect<A, { E }, { R }>) -> Data.Option<A> raises { E } uses { R } {
    Data.Option.Some { value: run work }
}

effect fn after<A: type>(limit: Duration, value: A) -> A uses { Clock } {
    run Clock.sleep(limit)
    value
}

effect fn failAfter<A: type>(limit: Duration) -> A raises { Timeout } uses { Clock } {
    run Clock.sleep(limit)
    fail Timeout
}

// Recurrence is data, not control: a Schedule decides whether and when to run
// another attempt after one completes. It cannot stop an attempt that is still
// running; that is what race (and so timeout) is for. Compose them:
//   work.timeout(500ms).retry<Timeout>(Schedule.Spaced { every: 100ms, count: 3 })
pub enum Schedule {
    Times { count: i64 }
    Spaced { every: Duration, count: i64 }
}

// retry, repeat, either, delay, timeoutTo: as in corpus/C/library.ef, over the
// same kernel. all/both/forEach wait on open question O3 (group failure policy).
