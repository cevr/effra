import go strings "strings"
import go strconv "strconv"
import go sdk "effra.local/prototype/examples/sdk"

effect fn program() -> void uses { Foreign, Console, Scheduler } {
    let name = run strings.ToUpper("ada")
    run Console.log(name)
    let raw = run strconv.ParseBool("invalid")
    if raw.hasError {
        run Console.log("partial result retained")
    } else {
        void
    }
    let fallback = run strconv.ParseBool("invalid").orFail().catch<GoError>(false)
    let slow = within 1ms {
        run sdk.Lookup("slow").orFail().catch<GoError>("failed")
    } otherwise {
        "timed out"
    }
    run Console.log(slow)
}

effect fn main() -> void {
    provide Foreign = Host, Console = Stdout, Scheduler = LiveScheduler {
        run program()
    }
}
