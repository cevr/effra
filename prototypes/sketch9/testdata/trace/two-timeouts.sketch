package deadlines

import "timeout"

// Two timeouts in a row, each caught by its own catch. The trace must link
// each handler to the deadline of its own timeout block's task, never to the
// other's (trace-188 round 1, M1).

func stall() (string, error[timeout.Expired]) uses Scheduler {
	value := try timeout.After(1ms) { block() }
	return value
}

func block() string uses Scheduler {
	Scheduler.Sleep(10s)
	return "woke"
}

wire Clock {
	Scheduler = LiveScheduler{}
}

func main() uses Console {
	first := with(Clock) { stall() } catch {
	case timeout.Expired:
		"first timed out"
	}
	Console.Println(first)
	second := with(Clock) { stall() } catch {
	case timeout.Expired:
		"second timed out"
	}
	Console.Println(second)
}
