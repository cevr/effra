package lookup

import "timeout"

// Failure: the lookup runs in a timeout block, its own task, and fails with
// OrderNotFound. The failure crosses the task boundary and reaches the catch
// in report.

type OrderNotFound struct{ ID string }

type Order struct {
	ID    string
	Total int64
}

type Orders interface {
	Find(id string) (Order, error[OrderNotFound])
}

func describe(id string) (string, error[OrderNotFound | timeout.Expired]) uses Orders, Scheduler {
	order := try timeout.After(1s) { Orders.Find(id) }
	return "found " + order.ID
}

type MemoryOrders struct{}

func (MemoryOrders) Find(id string) (Order, error[OrderNotFound]) {
	if id == "42" {
		return Order{ID: id, Total: 1999}
	}
	return OrderNotFound{ID: id}
}

wire Live {
	Orders = MemoryOrders{}
	Scheduler = LiveScheduler{}
}

func report(id string) uses Console {
	outcome := with(Live) { describe(id) } catch {
	case OrderNotFound:
		"no such order"
	case timeout.Expired:
		"lookup timed out"
	}
	Console.Println(outcome)
}

func main() uses Console {
	report("7")
}
