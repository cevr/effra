package calls

// Two calls of one operation: the first returns ok, the second fails with
// Missing, which the catch in main handles. The trace must link the handler
// to the second call's exit and say nothing causal about the first (trace-188
// round 1, M1).

type Missing struct{}

type Store interface {
	Get(id string) (string, error[Missing])
}

type Memory struct{}

func (Memory) Get(id string) (string, error[Missing]) {
	if id == "ok" {
		return "success"
	}
	return Missing{}
}

wire Live {
	Store = Memory{}
}

func load() (string, error[Missing]) uses Store {
	first := try Store.Get("ok")
	second := try Store.Get("bad")
	return first + second
}

func main() uses Console {
	result := with(Live) { load() } catch {
	case Missing:
		"missing"
	}
	Console.Println(result)
}
