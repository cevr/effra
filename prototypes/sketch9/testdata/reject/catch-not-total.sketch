// want S103
package checkout

type OrderNotFound struct{ ID string }
type GatewayDown struct{}

type Order struct {
	ID    string
	Total int64
}

type Orders interface {
	Find(id string) (Order, error[OrderNotFound])
}

type Gateway interface {
	Charge(order Order) (string, error[GatewayDown])
}

type MemoryOrders struct{}

func (MemoryOrders) Find(id string) (Order, error[OrderNotFound]) {
	if id == "42" {
		return Order{ID: id, Total: 1999}
	}
	return OrderNotFound{ID: id}
}

type FakeGateway struct{}

func (FakeGateway) Charge(order Order) (string, error[GatewayDown]) {
	return "auth-7"
}

func pay(id string) (string, error[OrderNotFound | GatewayDown]) uses Orders, Gateway {
	order := try Orders.Find(id)
	return Gateway.Charge(order)
}

// A catch with no try must cover every error; GatewayDown is missing.
func main() uses Console {
	outcome := with(wire{ Orders = MemoryOrders{}; Gateway = FakeGateway{} }) { pay("42") } catch {
	case OrderNotFound:
		"no such order"
	}
	Console.Println(outcome)
}
