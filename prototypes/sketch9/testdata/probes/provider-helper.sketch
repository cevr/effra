// out: ok
package demo
type Fault struct{}
func unused() error[Fault] { return Fault{} }
type Store interface { Get() string }
type Mem struct{}
func pure() string { return "ok" }
func (Mem) Get() string { return pure() }
func main() uses Console {
  with(wire{ Store = Mem{} }) { Console.Println(Store.Get()) }
}
